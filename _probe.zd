use "./critters" for CritterHunt, CritterTurn, CritterFoe, CritterAlly, CritterMatch,
    CritterGrowth, CritterGame, CritterWorld, critterNewHunt, critterStep,
    critterNewGame, critterWalk, critterAct, critterRegionKey,
    critterFreshWorld, critterTerrainPath, critterTerrainLayers, critterHeroPath,
    critterHeroEyePath, critterAt, critterFoeSpriteSize, critterFoeSpriteLeft,
    critterFoeSpriteTop, critterSparklePath, critterBarFillPath, critterFraction,
    critterMenuPath, critterDexCardPath, critterDexSpriteLeft, critterDexSpriteTop,
    critterPartyRowPath, critterPartySpriteTop, critterSin, critterRound,
    critterMapExtent, critterMapOriginLeft, critterMapOriginTop, critterMapHeatPath,
    critterMapCursorPath, critterMapDotPath, CritterExtent

record ProbeRun
    game is CritterHunt
    log  is List of Text

state probe2Script is static List of Text from probeAppendAll with head is (
    probeAppendAll with head is (
        probeFightsFrom with count is 40, taken is ["status", "gym", "challenge"]),
        rest is ["gym", "status", "challenge"]),
    rest is (
        probeAppendAll with head is (
            probeSwapsFrom with count is 30, taken is empty),
        rest is [
            "run", "gym", "hunt 6", "status", "wait", "wait", "throw", "fight",
            "throw", "dex", "challenge", "run", "quit"])

function probeFightsFrom with count, taken
    if count is 0
        give taken
    give probeFightsFrom with count is count - 1, taken is (append "fight" to taken)

function probeSwapsFrom with count, taken
    if count is 0
        give taken
    give probeSwapsFrom with count is count - 1,
        taken is (append "swap" to (append "fight" to taken))

state probe2Log is static List of Text from (
    probeAll2 with run is (
        ProbeRun with game is (
            critterNewHunt with caught is ["rambit", "pingpup", "loopworm"],
            growth is (
                set "loopworm" to (
                    CritterGrowth with level is 1, xp is 0, evolveEarly is 15, evolveLate is 40) in (
                    set "pingpup" to (
                        CritterGrowth with level is 44,
                        xp is 560,
                        evolveEarly is 20,
                        evolveLate is 45) in (
                        set "rambit" to (
                            CritterGrowth with level is 19,
                            xp is 260,
                            evolveEarly is 20,
                            evolveLate is 45) in empty))),
            badges is 0,
            seed is 424242),
        log is empty),
    index is 0).log

function probeAll2 with run, index
    if index is (listLength of probe2Script)
        give run
    with cmd is (valueOr with maybe is (listAt with value is probe2Script, index is index), fallback is "")
    with turn is (critterStep with game is run.game, input is cmd)
    give probeAll2 with run is (
        ProbeRun with game is turn.game,
        log is (append (
            probeDigest with game is turn.game,
            done is turn.done) to (
            probeAppendAll with head is (append "$ " + cmd to run.log),
            rest is turn.printed))),
        index is index + 1

state probeCycle is static List of Text starting [
    "hunt", "fight", "wait", "throw", "status", "fight", "throw", "swap", "fight",
    "throw", "dex", "hunt 4", "fight", "fight", "throw", "gym", "wait", "fight"]

state probeTail is static List of Text starting [
    "challenge", "fight", "fight", "fight", "fight", "fight", "fight", "fight",
    "fight", "swap", "fight", "status", "gym", "run", "bogus", "hunt", "run", "quit"]

state probeScript is static List of Text from probeAppendAll with head is (
    probeScriptFrom with round is 0, taken is empty), rest is probeTail

function probeScriptFrom with round, taken
    if round is 12
        give taken
    give probeScriptFrom with round is round + 1,
        taken is (probeAppendAll with head is taken, rest is probeCycle)

function probeAppendAll with head, rest
    from rest
    fold each item into taken starting head to (append item to taken)

state probeLog is static List of Text from (
    probeAll with run is (
        ProbeRun with game is (
            critterNewHunt with caught is empty, growth is empty, badges is 0, seed is 7),
        log is empty),
    index is 0).log

function probeAll with run, index
    if index is (listLength of probeScript)
        give run
    with cmd is (valueOr with maybe is (listAt with value is probeScript, index is index), fallback is "")
    with turn is (critterStep with game is run.game, input is cmd)
    give probeAll with run is (
        ProbeRun with game is turn.game,
        log is (append (
            probeDigest with game is turn.game,
            done is turn.done) to (
            probeAppendAll with head is (append "$ " + cmd to run.log),
            rest is turn.printed))),
        index is index + 1

function probeDigest with game, done
    give "~ st=" + (text of game.stamina) + " bd=" + (text of game.badges) + " ct=" + (
        join with parts is game.caught, using is ",") + " ally=" + (probeAlly of game) + (
        " foe=") + (probeFoe of game) + " gym=" + (probeGym of game) + " bench=" + (
        probeBench of game) + " gr=" + (probeGrowth of game) + " seed=" + (
        text of game.seed) + (" DONE" if done otherwise "")

function probeAlly of game
    when game.ally
        None
            give "-"
        Some with ally
            give ally.name + ":" + (text of ally.hp)

function probeFoe of game
    when game.foe
        None
            give "-"
        Some with foe
            give foe.critter.name + ":" + (text of foe.hp) + "/" + (text of foe.maxHp) + (
                " lv") + (text of foe.level) + " s" + (text of foe.stage) + " c" + (
                text of foe.calm) + " sh" + ("1" if foe.shiny otherwise "0") + " tr" + foe.trainer

function probeGym of game
    when game.gym
        None
            give "-"
        Some with match
            give (text of match.leader) + ":" + (text of match.slot)

function probeBench of game
    give join with parts is (
        probeBenchRows with game is game, names is (keys of game.benchHp), index is 0, taken is empty),
        using is ";"

function probeBenchRows with game, names, index, taken
    if index is (listLength of names)
        give taken
    with name is (valueOr with maybe is (listAt with value is names, index is index), fallback is "")
    give probeBenchRows with game is game,
        names is names,
        index is index + 1,
        taken is (append name + "=" + (
            text of (valueOr with maybe is (mapAt with value is game.benchHp, key is name), fallback is 0)) to taken)

function probeGrowth of game
    give join with parts is (
        probeGrowthRows with game is game, names is (keys of game.growth), index is 0, taken is empty),
        using is ";"

function probeGrowthRows with game, names, index, taken
    if index is (listLength of names)
        give taken
    with name is (valueOr with maybe is (listAt with value is names, index is index), fallback is "")
    with growth is (
        valueOr with maybe is (mapAt with value is game.growth, key is name),
        fallback is (CritterGrowth with level is 0, xp is 0, evolveEarly is 0, evolveLate is 0))
    give probeGrowthRows with game is game,
        names is names,
        index is index + 1,
        taken is (append name + ":" + (text of growth.level) + ":" + (text of growth.xp) + ":" + (
            text of growth.evolveEarly) + ":" + (text of growth.evolveLate) to taken)

view title is "critters probe"
    Column
        each printed in probeLog
            Text printed, class is "l"
        each printed in probe2Log
            Text printed, class is "m"
        each printed in probeWalkLog
            Text printed, class is "w"
        each printed in probeWalkLog2
            Text printed, class is "x"
        each printed in probeDrawLog
            Text printed, class is "d"
        each printed in probeGeomLog
            Text printed, class is "g"
        each printed in probeMapLog
            Text printed, class is "p"

# --- world walk scenarios ---------------------------------------------------

record ProbeWalk
    game is CritterGame
    log  is List of Text

state probeWalkCycle is static List of Text starting [
    "w:right", "w:right", "w:right", "w:right", "w:right", "w:right", "w:right",
    "w:right", "w:right", "w:right", "w:right", "w:right", "w:right", "w:right",
    "w:up", "w:up", "w:up", "w:up", "w:up", "w:up", "w:up", "w:up",
    "w:left", "w:left", "w:left", "w:left", "w:left", "w:left", "w:left",
    "w:left", "w:left", "w:left", "w:left", "w:left", "w:left", "w:left",
    "w:down", "w:down", "w:down", "w:down", "w:down", "w:down", "w:down", "w:down"]

state probeBattleCycle is static List of Text starting [
    "a:fight", "a:throw", "w:right", "w:down", "a:fight", "w:up"]

state probeWalkScript is static List of Text from probeBattlesFrom with count is 40,
    taken is (probeWalksFrom with count is 3, taken is empty)

function probeWalksFrom with count, taken
    if count is 0
        give taken
    give probeWalksFrom with count is count - 1,
        taken is (probeAppendAll with head is taken, rest is probeWalkCycle)

function probeBattlesFrom with count, taken
    if count is 0
        give taken
    give probeBattlesFrom with count is count - 1,
        taken is (probeAppendAll with head is taken, rest is probeBattleCycle)

function probeWalkRun
    give probeWalkAll with run is (
        ProbeWalk with game is (
            critterNewGame with caught is empty, growth is empty, badges is 0, seed is 99),
        log is empty),
        index is 0

state probeWalkLog is static List of Text from (probeWalkRun).log

state probeMapLog is static List of Text from probeMapDump of (probeWalkRun).game

function probeMapDump of game
    with span is (critterMapExtent of game)
    give append "dot|" + (critterMapDotPath of game) to (
        append "cursor|" + (critterMapCursorPath of game) to (
            probeHeatRows with game is game, heat is 0, taken is [
                "extent|" + (text of span.minX) + "|" + (text of span.maxX) + "|" + (
                    text of span.minY) + "|" + (text of span.maxY) + "|" + (
                    text of (critterMapOriginLeft of game)) + "|" + (
                    text of (critterMapOriginTop of game))]))

function probeHeatRows with game, heat, taken
    if heat is 7
        give taken
    give probeHeatRows with game is game,
        heat is heat + 1,
        taken is (append "heat|" + (text of heat) + "|" + (
            critterMapHeatPath with game is game, heat is heat) to taken)

state probeWalkLog2 is static List of Text from (
    probeWalkAll with run is (
        ProbeWalk with game is (
            critterNewGame with caught is empty, growth is empty, badges is 5, seed is 1234),
        log is empty),
    index is 0).log

function probeWalkAll with run, index
    if index is (listLength of probeWalkScript)
        give run
    with cmd is (
        valueOr with maybe is (listAt with value is probeWalkScript, index is index),
        fallback is "")
    with played is (
        (critterWalk with game is run.game, dir is (after with value is cmd, delimiter is ":")) if (
            startsWith with value is cmd, prefix is "w:") otherwise (
            critterAct with game is run.game, cmd is (after with value is cmd, delimiter is ":")))
    give probeWalkAll with run is (
        ProbeWalk with game is played,
        log is (append (probeWorldDigest of played) to (
            probeAppendAll with head is (append "$ " + cmd to run.log),
            rest is (probeLogged of played)))),
        index is index + 1

function probeLogged of game
    from game.printed
    map each printed to "L " + printed

function probeWorldDigest of game
    give "~ ph=" + game.phase + " at=" + (
        critterRegionKey with x is game.wx, y is game.wy) + " rg=" + (
        join with parts is (keys of game.regions), using is "|") + " st=" + (
        text of game.hunt.stamina) + " bd=" + (text of game.hunt.badges) + " ct=" + (
        join with parts is game.hunt.caught, using is ",") + " ally=" + (
        probeAlly of game.hunt) + " foe=" + (probeFoe of game.hunt) + " gr=" + (
        probeGrowth of game.hunt) + " seed=" + (text of game.hunt.seed) + (newline) + "> " + (
        game.world.tiles) + " @" + (text of game.world.px) + "," + (
        text of game.world.py) + " s" + (text of game.world.steps) + " d" + (
        text of game.world.danger)

# --- drawing scenarios ------------------------------------------------------

state probeWorld is static CritterWorld from critterFreshWorld with seed is 99, danger is 0

state probeTimes is static List of Decimal starting [0.0, 1234.5, 98765.25]

state probeDrawLog is static List of Text from probeDrawTimes with index is 0, taken is empty

function probeDrawTimes with index, taken
    if index is (listLength of probeTimes)
        give taken
    with time is (valueOr with maybe is (listAt with value is probeTimes, index is index), fallback is 0.0)
    give probeDrawTimes with index is index + 1,
        taken is (append (probeStamp with time is time, layer is "heroEye", drawn is (
            critterHeroEyePath with world is probeWorld, time is time)) to (
            append (probeStamp with time is time, layer is "hero", drawn is (
                critterHeroPath with world is probeWorld, time is time)) to (
                probeDrawLayers with time is time, layer is 0, taken is taken)))

function probeDrawLayers with time, layer, taken
    if layer is (listLength of critterTerrainLayers)
        give taken
    with name is (valueOr with maybe is (listAt with value is critterTerrainLayers, index is layer), fallback is "")
    give probeDrawLayers with time is time,
        layer is layer + 1,
        taken is (append (
            probeStamp with time is time,
            layer is name,
            drawn is (critterTerrainPath with world is probeWorld, layer is name, time is time)) to taken)

function probeStamp with time, layer, drawn
    give (text of time) + "|" + layer + "|" + drawn

# --- battle / dex / map / party geometry ------------------------------------

state probeStages is static List of Whole starting [1, 2, 3]
state probeDrawTimes2 is static List of Decimal starting [0.0, 917.5, 40321.75]
state probeNums is static List of Whole starting [7, 1, 0, 5, 13, 19]
state probeDens is static List of Whole starting [10, 3, 5, 5, 40, 20]

state probeGeomLog is static List of Text from probePartyRows with slot is 0,
    taken is (
        probeDexSlots with slot is 0,
        taken is (
            probeMenuSlots with slot is 0,
            taken is (
                probeBars with index is 0,
                taken is (probeSprites with index is 0, taken is empty))))

function probeFakeFoe with stage
    give CritterFoe with critter is (critterAt of 0),
        level is 5,
        stage is stage,
        maxHp is 10,
        attack is 3,
        speed is 9,
        hp is 7,
        calm is 0,
        shiny is yes,
        trainer is ""

function probeSprites with index, taken
    if index is 9
        give taken
    with stage is (
        valueOr with maybe is (
            listAt with value is probeStages,
            index is (valueOr with maybe is (quotient with value is index, divisor is 3), fallback is 0)),
        fallback is 1)
    with time is (
        valueOr with maybe is (
            listAt with value is probeDrawTimes2,
            index is (valueOr with maybe is (mod with value is index, divisor is 3), fallback is 0)),
        fallback is 0.0)
    with foe is (probeFakeFoe with stage is stage)
    with head is ((text of stage) + "|") + (text of time) + "|"
    give probeSprites with index is index + 1,
        taken is (append "ally|" + head + (
            text of (probeAllySize with stage is stage)) + "|20|" + (
            text of (probeAllyTop with stage is stage, time is time)) to (
            append "spark|" + head + (
                critterSparklePath with foe is foe, time is time) to (
                append "foe|" + head + (text of (critterFoeSpriteSize of foe)) + "|" + (
                    text of (critterFoeSpriteLeft of foe)) + "|" + (
                    text of (critterFoeSpriteTop with foe is foe, time is time)) to taken)))

# The ally sprite's size and bob are computed from a *name*, so the probe
# reproduces the arithmetic against a stage directly.
function probeAllySize with stage
    give critterRound of (44.0 * (1.0 + ((decimalOf of (stage - 1)) * 0.14)))

function probeAllyTop with stage, time
    give (142 + (critterRound of ((critterSin of ((time / 380.0) + (pi))) * 2.0))) + (
        44 - (probeAllySize with stage is stage))

function probeBars with index, taken
    if index is (listLength of probeNums)
        give taken
    with num is (valueOr with maybe is (listAt with value is probeNums, index is index), fallback is 0)
    with den is (valueOr with maybe is (listAt with value is probeDens, index is index), fallback is 1)
    with head is ((text of num) + "/") + (text of den) + "|"
    give probeBars with index is index + 1,
        taken is (append "xpbar|" + head + (
            critterBarFillPath with left is 74,
            top is 168,
            wide is 168,
            tall is 3,
            fraction is (critterFraction with value is num, whole is den)) to (
            append "bar|" + head + (
                critterBarFillPath with left is 24,
                top is 66,
                wide is 200,
                tall is 5,
                fraction is (critterFraction with value is num, whole is den)) to taken))

function probeMenuSlots with slot, taken
    if slot is 4
        give taken
    give probeMenuSlots with slot is slot + 1,
        taken is (append "menu|" + (text of slot) + "|" + (critterMenuPath of slot) to taken)

function probeDexSlots with slot, taken
    if slot is 12
        give taken
    give probeDexSlots with slot is slot + 1,
        taken is (append "dex|" + (text of slot) + "|" + (critterDexCardPath of slot) + "|" + (
            text of (critterDexSpriteLeft of slot)) + "|" + (
            text of (critterDexSpriteTop of slot)) to taken)

function probePartyRows with slot, taken
    if slot is 8
        give taken
    give probePartyRows with slot is slot + 1,
        taken is (append "party|" + (text of slot) + "|" + (critterPartyRowPath of slot) + "|" + (
            text of (critterPartySpriteTop of slot)) to taken)
