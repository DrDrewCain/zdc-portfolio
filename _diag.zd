use "./critters" for CritterGame, critterNewGame, critterWalk, critterAct

state moves is static List of Text starting [
    "w:right", "w:right", "w:down", "w:left", "w:up", "w:up", "w:right",
    "a:hunt", "a:fight", "a:throw", "a:fight", "a:throw", "a:wait", "a:hunt 3"]

state trace is static List of Text from diagFrom with game is (
    critterNewGame with caught is empty, growth is empty, badges is 0, seed is 99),
    index is 0,
    taken is empty

function diagFrom with game, index, taken
    if index is 41
        give append "END phase=" + game.phase + " last=" + (
            valueOr with maybe is (listAt with value is game.printed, index is (listLength of game.printed) - 1), fallback is "") to taken
    with cmd is (
        valueOr with maybe is (listAt with value is moves, index is (
            valueOr with maybe is (mod with value is index, divisor is 14), fallback is 0)),
        fallback is "a:hunt")
    with played is (
        (critterWalk with game is game, dir is (after with value is cmd, delimiter is ":")) if (
            startsWith with value is cmd, prefix is "w:") otherwise (
            critterAct with game is game, cmd is (after with value is cmd, delimiter is ":")))
    give diagFrom with game is played,
        index is index + 1,
        taken is (append (text of index) + " " + cmd + " -> " + played.phase + " | " + (
            valueOr with maybe is (listAt with value is played.printed, index is (listLength of played.printed) - 1), fallback is "") to taken)

view title is "diag"
    Column
        each printed in trace
            Text printed, class is "t"
