# game2048.zd — the engine, with no view.
#
# Split out of `twenty48.zd` so the terminal can raise the same game the
# standalone program does. Everything here is a function of its arguments
# and there is no `state` at all: the board is passed in and a new one
# comes back, which is what makes one engine serve two front ends without
# either knowing about the other.

choice Direction
    Left  is "left"
    Right is "right"
    Up    is "up"
    Down  is "down"

record Board
    cells is List of Whole
    score is Whole
    seed  is Whole
    won   is Truth
    over  is Truth

# What one slid line came to, and what it was worth. A record because a
# function gives one value and this is two facts about one answer.
record Slid
    line   is List of Whole
    gained is Whole

# --- sliding one line ------------------------------------------------------
#
# The whole game is this function. Everything else is which four cells to
# hand it and where to put the answer back.

function cellOf with cells, index
    give valueOr with maybe is (listAt with value is cells, index is index), fallback is 0

# The non-empty tiles, in order, with the gaps taken out.
function packedRun of line
    from line
    keep each value where value > 0

# Merge equal neighbours, left to right, consuming both.
#
# A tile that has just mergedRun is not eligible to merge again this move —
# the reason `[2,2,4]` becomes `[4,4]` and not `[8]`. That falls out of
# dropping *two* cells on a merge and one otherwise, rather than out of a
# flag: there is no "already mergedRun" bit to forget to clear.
function mergedRun with rest, taken, gained
    when listAt with value is rest, index is 0
        None
            give (Slid with line is taken, gained is gained)
        Some with head
            when listAt with value is rest, index is 1
                None
                    give (Slid with line is (append head to taken), gained is gained)
                Some with next
                    if head is next
                        give mergedRun with rest is (listDrop with items is rest, count is 2), taken is (append (head + next) to taken), gained is gained + head + next
                    give mergedRun with rest is (listDrop with items is rest, count is 1), taken is (append head to taken), gained is gained

function padTo with line, size
    if (listLength of line) >= size
        give line
    give padTo with line is (append 0 to line), size is size

function slideLine of line
    give paddedSlid of (mergedRun with rest is (packedRun of line), taken is empty, gained is 0)

function paddedSlid of slid
    give (Slid with line is (padTo with line is slid.line, size is 4), gained is slid.gained)

# --- which four cells a direction slides -----------------------------------
#
# `lineOf` reads line `index` in the order the tiles travel, so `slideLine`
# is always "toward position 0" and never has to know about the direction.
# `cellFrom` is its inverse: for a cell spot (row, column), which line it came
# from and which position in it.

function lineOf with cells, direction, index
    when direction
        Left
            give [(cellOf with cells is cells, index is index * 4), (cellOf with cells is cells, index is index * 4 + 1), (cellOf with cells is cells, index is index * 4 + 2), (cellOf with cells is cells, index is index * 4 + 3)]
        Right
            give [(cellOf with cells is cells, index is index * 4 + 3), (cellOf with cells is cells, index is index * 4 + 2), (cellOf with cells is cells, index is index * 4 + 1), (cellOf with cells is cells, index is index * 4)]
        Up
            give [(cellOf with cells is cells, index is index), (cellOf with cells is cells, index is index + 4), (cellOf with cells is cells, index is index + 8), (cellOf with cells is cells, index is index + 12)]
        Down
            give [(cellOf with cells is cells, index is index + 12), (cellOf with cells is cells, index is index + 8), (cellOf with cells is cells, index is index + 4), (cellOf with cells is cells, index is index)]

# The four slid lines, as a list of lists. `.line` here and `.gained` in
# `gainedFrom` below: one `Slid` carries both answers and each caller takes
# the half it needs.
function slidLines with cells, direction
    from (range with start is 0, stop is 4)
    map each index to (slideLine of (lineOf with cells is cells, direction is direction, index is index)).line

function gainedFrom with cells, direction
    from (range with start is 0, stop is 4)
    fold each index into total starting 0 to total + (slideLine of (lineOf with cells is cells, direction is direction, index is index)).gained

# Which line, and which position in it, the cell spot `spot` reads back from.
function lineIndexFor with direction, spot
    when direction
        Left
            give valueOr with maybe is (quotient with value is spot, divisor is 4), fallback is 0
        Right
            give valueOr with maybe is (quotient with value is spot, divisor is 4), fallback is 0
        Up
            give valueOr with maybe is (mod with value is spot, divisor is 4), fallback is 0
        Down
            give valueOr with maybe is (mod with value is spot, divisor is 4), fallback is 0

function spotFor with direction, spot
    when direction
        Left
            give valueOr with maybe is (mod with value is spot, divisor is 4), fallback is 0
        Right
            give 3 - (valueOr with maybe is (mod with value is spot, divisor is 4), fallback is 0)
        Up
            give valueOr with maybe is (quotient with value is spot, divisor is 4), fallback is 0
        Down
            give 3 - (valueOr with maybe is (quotient with value is spot, divisor is 4), fallback is 0)

# The fallback is a written-out empty line rather than `empty`, which is
# ambiguous between a list and a map with nothing here to settle it.
function blankLine
    give [0, 0, 0, 0]

function lineOfLines with lines, index
    give valueOr with maybe is (listAt with value is lines, index is index), fallback is blankLine

function movedCells with lines, direction
    from (range with start is 0, stop is 16)
    map each spot to (cellOf with cells is (lineOfLines with lines is lines, index is (lineIndexFor with direction is direction, spot is spot)), index is (spotFor with direction is direction, spot is spot))

# --- spawning --------------------------------------------------------------

function emptyCount of cells
    from cells
    fold each value into total starting 0 to total + (oneIfEmpty of value)

function oneIfEmpty of value
    if value is 0
        give 1
    give 0

# The index of the `wanted`-th empty cell, scanning from the left. A
# position among the empties rather than a position on the board, so the
# choice is uniform over the cells that can actually take a tile.
function emptyAt with cells, wanted, spot, seen
    if spot >= 16
        give 0
    if (cellOf with cells is cells, index is spot) is 0
        if seen is wanted
            give spot
        give emptyAt with cells is cells, wanted is wanted, spot is spot + 1, seen is seen + 1
    give emptyAt with cells is cells, wanted is wanted, spot is spot + 1, seen is seen

# A 2 nine times out of ten and a 4 otherwise, exactly as the original.
function spawnedValue of seed
    if (valueOr with maybe is (randomBelow with seed is seed, bound is 10), fallback is 0) is 9
        give 4
    give 2

function withSpawn with cells, seed
    if (emptyCount of cells) is 0
        give cells
    give setAt with items is cells, index is (emptyAt with cells is cells, wanted is (valueOr with maybe is (randomBelow with seed is seed, bound is (emptyCount of cells)), fallback is 0), spot is 0, seen is 0), item is (spawnedValue of (nextSeed of seed))

# --- a move ----------------------------------------------------------------

# `yes` when no direction would change anything. Checked by trying all four
# rather than by reasoning about adjacency — the original's comment says
# why, and it holds here: "are there equal neighbours" and "would a move do
# anything" are the same question only if the slide is correct, and this way
# the check cannot drift away from the thing it predicts.
function noMovesLeft of cells
    if (emptyCount of cells) > 0
        give no
    if not (sameCells with left is cells, right is (movedCells with lines is (slidLines with cells is cells, direction is Left), direction is Left))
        give no
    if not (sameCells with left is cells, right is (movedCells with lines is (slidLines with cells is cells, direction is Right), direction is Right))
        give no
    if not (sameCells with left is cells, right is (movedCells with lines is (slidLines with cells is cells, direction is Up), direction is Up))
        give no
    if not (sameCells with left is cells, right is (movedCells with lines is (slidLines with cells is cells, direction is Down), direction is Down))
        give no
    give yes

function sameCells with left, right
    from (range with start is 0, stop is 16)
    fold each spot into same starting yes to same and ((cellOf with cells is left, index is spot) is (cellOf with cells is right, index is spot))

function holdsWinningTile of cells
    from cells
    fold each value into found starting no to found or (value >= 2048)

# A move that changes nothing must not spawn a tile, or holding a direction
# against a wall would fill the board for free.
function afterMove with board, direction
    if board.over
        give board
    if sameCells with left is board.cells, right is (movedCells with lines is (slidLines with cells is board.cells, direction is direction), direction is direction)
        give board
    give afterScoring with board is board, moved is (movedCells with lines is (slidLines with cells is board.cells, direction is direction), direction is direction), gained is (gainedFrom with cells is board.cells, direction is direction)

function afterScoring with board, moved, gained
    give withScore with board is board, cells is (withSpawn with cells is moved, seed is board.seed), gained is gained

function withScore with board, cells, gained
    give (Board with cells is cells, score is board.score + gained, seed is (nextSeed of (nextSeed of board.seed)), won is board.won or (holdsWinningTile of cells), over is (noMovesLeft of cells))

# --- a new game ------------------------------------------------------------

function freshCells of seed
    give withSpawn with cells is (withSpawn with cells is (filled with value is 0, count is 16), seed is seed), seed is (nextSeed of seed)

function freshBoard of seed
    give (Board with cells is (freshCells of seed), score is 0, seed is (nextSeed of (nextSeed of seed)), won is no, over is no)

# --- what a tile looks like -------------------------------------------------
#
# Beside the engine rather than beside either view, because both of them
# need it and neither owns it.

function tileClass of value
    if value is 0
        give "t t-empty"
    give "t t-" + (text of value)

function tileText of value
    if value is 0
        give ""
    give text of value
