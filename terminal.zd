# terminal.zd — the session. `src/components/terminal/terminal.tsx`, ported.
#
# WHAT IS HERE AND WHAT IS NEXT DOOR. `commands.zd` says what a command
# *means*, which is a pure function of the line and the catalogue. This
# holds what a session *is*: what has been printed, what mode the prompt is
# in, which game is up, and the line being typed. The original splits the
# same way and for the same reason — one half is testable without a DOM.
#
# WHY A TERMINAL IS A GOOD FIT. The screen is a list of lines and a command
# appends to it. There is nowhere in this file that output is mutated after
# it is printed, because there is nothing to mutate it with.
#
# THE ONE THING THE LANGUAGE GIVES FREE. `on key "~"` is a document
# listener, and the compiler emits one that stands down while a field has
# focus. So typing `~` *into* the terminal's own input does not close it,
# and nothing here says so.

use "./commands" for Outcome, Completion, runCommand, completionFor, commandNames
use "./codebreak" for Pegs, Round, newPegs, stepPegs
use "./lexer" for Lex, Reply, newLex, stepLex
use "./trader" for Ship, Move, newShip, stepTrader
use "./critters" for CritterGame, CritterGrowth, critterNewGame
use "./snake" for Snake, newSnake, snakeStep
use "./blocks" for Blocks, newBlocks, blocksStep
use "./game2048" for Board, Direction, cellOf, afterMove, freshBoard, tileClass, tileText
use "./mines" for Field,
    freshField,
    revealAt,
    flagAt,
    movedBy,
    mineStatus,
    mineViewBox,
    hiddenPath,
    flaggedPath,
    openPath,
    cursorPath,
    minePath
use "./life" for Life,
    stepLife,
    stamped,
    population,
    boardPath,
    lifeViewBox,
    gunCells,
    gliderCells,
    pulsarCells

# The screen: what has been printed, oldest first.
state screen is client List of Text starting ["mark's portfolio :: type 'help' to get started"]
state line is client Text starting ""
state open is client Truth starting no

# `shell`, or the name of a game the prompt has been handed to. The
# original's `Mode`, as a `Text` rather than a `choice`, because the value
# is compared and never matched on — and a `choice` here would mean a
# `when` in the view, which is a region rather than an attribute.
state mode is client Text starting "shell"

# Which full-panel game is up, or `""`. Separate from `mode`: a game that
# takes the whole panel still leaves the prompt underneath it, and quitting
# one returns to the shell rather than to the mode it was launched from.
state overlay is client Text starting ""

# The codebreak in progress. One cell rather than one per mode: only one
# game holds the prompt at a time, which is what `mode` already says.
#
# The seed comes from `clock`, because randomness here is a pure function
# of a seed the program owns and a literal would deal the same code to
# every reader on every load. `clock` in an initialiser is the one place a
# fresh number can honestly come from.
state pegs is client Pegs starting (newPegs of 1)
state lex is client Lex starting (newLex of 1)
state ship is client Ship starting (newShip of 1)

# The board, and whether it is advancing. `running` opens `yes`: the gun
# is the pattern that makes the rule legible and a still frame of it says
# nothing. A reader who wants to step it presses space.
# The board advances itself. `every "90ms" starting … to …` is the fold a
# clock performs — the step reads the cell it writes, which is the one
# cycle the language permits and the same one a `fold`'s accumulator is.
#
# `running` gates the step rather than the timer, so pausing and resuming
# do not become two timers with two phases and a board that stutters when
# it starts again.
state running is client Truth starting yes
state field is client Field starting (freshField of 1)

# The same engine the standalone `twenty48.zd` runs. One board here and
# one there, and neither knows about the other.
state tiles is client Board starting (freshBoard of 1)

# Two more self-advancing boards. Both step functions give the board back
# unchanged once it is dead, so neither needs a `running` gate of its own
# — a dead game is a still one by its own rule rather than by a flag
# beside it.
state serpent is client Snake every "110ms" starting (newSnake of 1) to (snakeStep of serpent)
state stack is client Blocks every "60ms" starting (newBlocks of 1) to (blocksStep of stack)

# The critter lab. It does not tick — it is turn based — so it is an
# ordinary cell rather than a stepping clock.
#
# `caught`, `growth` and `badges` open empty. The original keeps them in
# `localStorage`; making them `remembered` here would be one line and is
# the *terminal's* call rather than the game's, which is why the module
# takes them as arguments instead of holding them.
# `caught` is a `List of Text`, `growth` a `Map of Text to CritterGrowth`
# and `badges` a count — so the empty save is three empties of three
# different shapes, and the two collections need their types written
# because `empty` alone does not say which it is.
state labCaught is client List of Text starting empty
state labGrowth is client Map of Text to CritterGrowth starting empty
state lab is client CritterGame starting (critterNewGame with caught is labCaught, growth is labGrowth, badges is 0, seed is 1)

# The frame clock the lab's drawing reads. A function gives a value and
# reads no clock of its own, so the animated paths take the time as an
# argument and this is where it comes from.
state beat is client Decimal every frame
state bestScore is remembered Whole starting 0
state board is client Life every "90ms" starting (
    stamped with pattern is gunCells,
    seed is 1) to (steppedIf with game is board,
    moving is running)

function steppedIf with game, moving
    if moving
        give stepLife of game
    give game

# --- history ----------------------------------------------------------------
#
# `src/lib/terminal/history.ts`. Spans every mode, because recalling the
# trader command you typed two games ago is exactly the thing a shell is
# expected to do.
#
# The cursor is an index from the *end*: 0 is the line being typed, 1 is
# the last command, and walking back past the oldest stops rather than
# wrapping. `draft` holds what was half-typed when the walk started, so
# arrowing all the way forward gives it back rather than emptying the box.
state history is client List of Text starting empty
state cursor is client Whole starting 0
state draft is client Text starting ""

function recalled with all, back
    if back > (listLength of all)
        give valueOr with maybe is (listAt with value is all, index is 0), fallback is ""
    give valueOr with maybe is (listAt with value is all, index is (listLength of all) - back),
        fallback is ""

function steppedBack with all, position
    if position > ((listLength of all) - 1)
        give listLength of all
    give position + 1

# --- the prompt -------------------------------------------------------------

function promptFor of mode
    if mode is "trader"
        give "trader>"
    if mode is "lexer"
        give "lexer>"
    if mode is "codebreak"
        give "code>"
    if mode is "games"
        give ">"
    give "$"

# A sample of the move each mode expects, shown greyed in the input.
function hintFor of mode
    if mode is "trader"
        give "look"
    if mode is "lexer"
        give "crane"
    if mode is "codebreak"
        give "1234"
    if mode is "games"
        give "2048"
    give "help"

# --- what a submitted line does ---------------------------------------------
#
# `append` puts one item on the end; a command prints several, so the two
# lists are joined a line at a time.
function joined with head, rest
    from rest
    fold each printed into taken starting head to (append printed to taken)

# The banner `clear` leaves behind, which is the banner the session opened
# with. The original clears to nothing; leaving the greeting is the same
# decision `neofetch` makes about a blank screen being unhelpful.
function opening
    give ["mark's portfolio :: type 'help' to get started"]
