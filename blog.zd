# blog.zd — the portfolio's writing, read off disk at build time.
#
# WHAT THIS REPLACES. Next.js reads the same directory with `gray-matter`
# for the header and `next-mdx-remote` for the body, at request time or at
# ISR time, with `remark-gfm` in the pipeline. Here `build list`, `build
# read` and `build markdown` do it in the compiler, once, and what ships is
# HTML in a document. There is no markdown renderer in the bundle because
# there is no markdown left to render.
#
# WHAT THAT COSTS AND WHAT IT BUYS. It costs the ability to add a post
# without rebuilding — this is a `static` placement and `static` means the
# build host holds it. It buys a page that needs no JavaScript to show its
# text, a bundle with no parser in it, and a broken post that is a failed
# build rather than a blank page.
#
# THE ONE THING THAT IS NOT PORTABLE. MDX lets a post embed a React
# component, and nothing here can. Every file in `content/` is plain
# markdown today — checked, not assumed — so nothing is lost yet. The day
# a post wants an interactive chart, that post needs a `component` in this
# language and a way to name it from the file, and neither exists.

use "./frontmatter" for fieldOf, bodyOf, slugOf, linkified
use "./data" for Line, now, about, aboutOpen, aboutStress, aboutClose, domains
use "./layers" for layerNames, reaches, oneIfReaches, tickClass

record Post
    slug    is Text
    title   is Text
    summary is Text
    date    is Text
    # Minutes, worked out on the build host. The reader is handed a number,
    # not the arithmetic and not the text it was measured from.
    minutes is Whole
    # `Markup`, not `Text`. `Text` sets `nodeValue`, so a post's `<h1>`
    # would arrive as four visible characters. `build markdown` is the only
    # expression that makes a `Markup` and `Prose` is the only element that
    # renders one; neither converts to the other in either direction.
    body    is Markup

# `Entry`, not `Post`: `record Post` already has that name, and a route
# variant and a record share one namespace. The compiler catches it as
# "`Post` is missing `title`, `summary`, `date`, and `body`" — the record
# constructor winning the name, which is exactly what happened.
route Site
    Home    is "/"
    Writing is "/blog"
    Entry   is "/blog" with slug is Text in slugs
    Work    is "/projects" with slug is Text in projectSlugs

state page is client Option of Site starting address

# Read at compile time and inlined. No boundary is crossed at run time, so
# this is a `List of Post` and not a `Remote of List of Post`.
state posts is static List of Post from readPosts with directory is "content/blog"

function readPosts with directory
    from build list directory
    map each path to (postFrom of path)

# The file is read once and handed on. There is no `let`, so "read it once"
# is spelled as a second function taking the text as a parameter.
function postFrom of path
    give postFromRaw with path is path, raw is build read path

# --- how long a post takes to read ---------------------------------------
#
# Ported from `src/lib/reading-time.ts`, which opens by saying why the usual
# implementation is wrong: prose and code are not consumed at the same rate.
# People read prose linearly and *scan* code — slower per token, far fewer
# tokens — so a post that is half fenced blocks gets badly overestimated by
# a flat words-per-minute rate.
#
# So the two are counted separately, at 220 words a minute and 60 code lines
# a minute, and the fences are split on rather than matched: a body cut on
# "```" alternates prose, code, prose, code, so the even pieces are read and
# the odd pieces are scanned. No regular expressions, because the language
# has none — the punctuation that is not a word is replaced with spaces and
# the rest is split on whitespace.

function segmentsOf of body
    give split with value is body, using is "```"

# Every other piece, starting at `index`. `2` because the split alternates.
function wordsFrom with pieces, index, total
    when listAt with value is pieces, index is index
        None
            give total
        Some with piece
            give wordsFrom with pieces is pieces, index is index + 2, total is total + (wordsIn of piece)

function codeLinesFrom with pieces, index, total
    when listAt with value is pieces, index is index
        None
            give total
        Some with piece
            give codeLinesFrom with pieces is pieces, index is index + 2, total is total + (linesIn of piece)

# A fenced block's own two fence lines are the delimiters that were split
# away, so what is left is the content plus the newline each side of it.
function linesIn of piece
    with counted is (listLength of (lines of piece)) - 2
    if counted < 0
        give 0
    give counted

# Table pipes, heading markers and emphasis are punctuation rather than
# words, so they become spaces before the split. `replace` is the prelude's.
function despunctuated of piece
    give replace with value is (replace with value is (replace with value is (replace with value is (replace with value is (replace with value is piece, old is "|", new is " "), old is "#", new is " "), old is ">", new is " "), old is "*", new is " "), old is "_", new is " "), old is (text of newline), new is " "

function wordsIn of piece
    from (split with value is (despunctuated of piece), using is " ")
    fold each word into total starting 0 to total + (oneIfWord of word)

function oneIfWord of word
    if isBlank of word
        give 0
    give 1

# Prose at 220 a minute plus code at 60 a minute, rounded. Anything with
# content in it is at least a one-minute read: rounding a short post to zero
# reads as an error rather than as brevity.
function readingMinutes of body
    with pieces is (segmentsOf of body)
    with words is (wordsFrom with pieces is pieces, index is 0, total is 0)
    with codeLines is (codeLinesFrom with pieces is pieces, index is 1, total is 0)
    with raw is ((decimalOf of words) / 220.0) + ((decimalOf of codeLines) / 60.0)
    with rounded is (valueOr with maybe is (round of raw), fallback is 1)
    if (words + codeLines) is 0
        give 0
    if rounded < 1
        give 1
    give rounded

function postFromRaw with path, raw
    give Post with slug is (slugOf of path), title is (fieldOf with raw is raw, key is "title"), summary is (fieldOf with raw is raw, key is "summary"), date is (fieldOf with raw is raw, key is "date"), minutes is (readingMinutes of (bodyOf of raw)), body is build markdown (linkified of (bodyOf of raw))

# ⚠️ THE ONE THING THE BUILD CAPABILITIES CANNOT DO, AND IT IS WORTH SAYING
# PLAINLY.
#
# This list is written out, and everything else on the page is read off
# disk. It was `from build list "content/blog"` first, and the compiler
# refused it:
#
#   `slugs` is not a list of values the build host can evaluate, so a route
#   parameter cannot be enumerated over it.
#
# A route parameter's `in` collection has to be a literal `static` list. So
# `build list` can decide what a page *contains* but not what pages
# *exist* — the directory populates the posts, and the URLs are declared.
# Adding a post is therefore two edits: the file, and this line.
#
# The refusal is not arbitrary. The compiler emits one document per value
# here, so the value set has to be settled before the build host has run
# anything; `build list` runs during the build, which is after. Closing
# that gap means letting a route enumerate over a build capability, and
# that is a change to when the document set is decided, not a bug fix.
state slugs is static List of Text starting ["2026-07-15-hello-world", "2026-07-16-things-that-move", "2026-07-18-critters-grew-up", "2026-07-20-judgment-became-an-act", "2026-07-24-the-shape-of-the-fuel", "2026-07-25-the-classifier-was-never-the-problem", "2026-07-25-the-optimization-that-was-wrong-twice", "2026-07-25-you-only-get-to-watch-one-person-think", "2026-07-31-coastlines-over-open-water", "2026-08-02-commitment-is-the-safety-feature", "2026-08-02-the-ruler-is-made-of-people", "2026-08-02-the-same-question-one-layer-up", "2026-08-02-the-student-beat-the-teacher", "2026-08-02-the-window-is-not-the-memory"]

state projectSlugs is static List of Text starting ["appmeee", "clawfreelance", "gridwright", "imsg-protocol", "judgehuman", "matrix-infras", "minimac-llm", "minineuromodel", "minitorch", "nlp-classifiers", "project-mercury", "spacetrader-wars", "tvm-kernel-opt", "vernos", "voxmatch", "zdeceptron"]

# --- the projects ----------------------------------------------------------
#
# The same three capabilities as the posts, over a different directory. A
# project carries a one-liner, a status, a stack and an order rather than a
# date and a summary, and `order` is a number written in the file so the
# author decides the sequence rather than the filesystem.

record Project
    slug      is Text
    title     is Text
    oneLiner  is Text
    status    is Text
    stack     is Text
    timeline  is Text
    rank      is Whole
    body      is Markup

state projects is static List of Project from readProjects with directory is "content/projects"

function readProjects with directory
    from build list directory
    map each path to (projectFrom of path)

function projectFrom of path
    give projectFromRaw with path is path, raw is build read path

# `order` comes out of the header as text and has to be a number to sort by.
# `parseWhole` gives an `Option`, because a header can say anything.
function projectFromRaw with path, raw
    give Project with slug is (slugOf of path), title is (fieldOf with raw is raw, key is "title"), oneLiner is (fieldOf with raw is raw, key is "oneLiner"), status is (fieldOf with raw is raw, key is "status"), stack is (unbracketed of (fieldOf with raw is raw, key is "stack")), timeline is (fieldOf with raw is raw, key is "timeline"), rank is (valueOr with maybe is (parseWhole of (fieldOf with raw is raw, key is "order")), fallback is 99), body is build markdown (linkified of (bodyOf of raw))

# `stack` is a YAML list — `[TypeScript, Next.js]` — and the brackets are
# the only part of that syntax this reads. Anything more is a YAML parser,
# and `frontmatter.zd` says why there is not one.
function unbracketed of value
    give withoutSuffix with value is (withoutPrefix with value is value, prefix is "["), suffix is "]"

state ranked is static List of Project from byRank with all is projects

# --- stack coverage --------------------------------------------------------
#
# The hero claims one person and the whole stack; this is the measurement of
# it, and it is `static`, so it is computed once on the build host from the
# same headers the project pages render. There is nowhere for it to drift to.

record Coverage
    layer is Text
    count is Whole
    width is Whole

# How many projects reach one layer.
function countFor with all, layer
    from all
    fold each project into total starting 0 to total + (oneIfReaches with stack is project.stack, layer is layer)

# The busiest layer, which the bars are scaled against — the question is "is
# any of this empty", not "what share is this", so the widest bar is the
# fullest layer rather than the project count.
function busiest with all, index, most
    when listAt with value is layerNames, index is index
        None
            give most
        Some with layer
            give busiest with all is all, index is index + 1, most is (max with first is most, second is (countFor with all is all, layer is layer))

state widest is static Whole from busiest with all is projects, index is 0, most is 1

state coverage is static List of Coverage from coverageOf with all is projects

function coverageOf with all
    from layerNames
    map each layer to (Coverage with layer is layer, count is (countFor with all is all, layer is layer), width is (percentOf with part is (countFor with all is all, layer is layer), whole is widest))

# The bar widths are classes, and a class per whole percent would be a
# hundred and one of them. Rounded to the nearest five, which is twenty-one
# and is finer than the eye reads on a 14px bar.
function rounded5 of percent
    give 5 * (valueOr with maybe is (quotient with value is percent + 2, divisor is 5), fallback is 0)

function percentOf with part, whole
    if whole is 0
        give 0
    give valueOr with maybe is (quotient with value is part * 100, divisor is whole), fallback is 0

# "5 of 5 layers" — how many are occupied at all.
state spanned is static Whole from spannedOf with all is projects, index is 0, total is 0

function spannedOf with all, index, total
    when listAt with value is layerNames, index is index
        None
            give total
        Some with layer
            give spannedOf with all is all, index is index + 1, total is total + (oneIfAny of (countFor with all is all, layer is layer))

function oneIfAny of count
    if count > 0
        give 1
    give 0

function byRank with all
    from all
    sort each project by project.rank

state missingProject is static Project from missingWork with title is "Not found"

function missingWork with title
    give Project with slug is "", title is title, oneLiner is "", status is "", stack is "", timeline is "", rank is 99, body is build markdown ""

function projectWith with all, slug, index, fallback
    when listAt with value is all, index is index
        None
            give fallback
        Some with project
            if project.slug is slug
                give project
            give projectWith with all is all, slug is slug, index is index + 1, fallback is fallback

# Newest first. Sorted on the build host, so the order is the same on every
# machine and costs the reader nothing.
state ordered is static List of Post from newestFirst with all is posts

function newestFirst with all
    from all
    sort each post by post.date

# The "no such post" post, built once on the build host. It cannot be
# constructed in the lookup below, because that runs in the browser and
# `build markdown` is only readable while the build is running — E0361 says
# so, and traces the call chain that reaches it.
state missingPost is static Post from missing with title is "Not found"

function missing with title
    give Post with slug is "", title is title, summary is "", date is "", minutes is 1, body is build markdown ""

function postWith with all, slug, index, fallback
    when listAt with value is all, index is index
        None
            give fallback
        Some with post
            if post.slug is slug
                give post
            give postWith with all is all, slug is slug, index is index + 1, fallback is fallback

# --- the view --------------------------------------------------------------

component Card with post
    Link (Entry with slug is post.slug), decoration is "none", color is "ink"
        Column class is "card", padding is 20, gap is 8
            Row gap is 6, align is "center", class is "meta"
                Text post.date
                Text "·"
                Text post.minutes
                Text "min read"
            Heading post.title, class is "card-title"
            Text post.summary, color is "muted", size is "small", lineHeight is 1.7

component Crumb
    Row gap is 8, align is "center", class is "cd"
        Text "←", class is "cd-arrow"
        Text "cd ../blog"

component Reading with post
    Column gap is 0
        Link Writing, decoration is "none", padding is 0
            Crumb
        Article
            Column gap is 0, padding is 0
                Row height is 28
                Row gap is 6, align is "center", class is "meta"
                    Text post.date
                    Text "·"
                    Text post.minutes
                    Text "min read"
                Heading post.title, class is "title"
                Row height is 34
                # The body, rendered. `Prose` is the only element whose
                # argument is parsed as HTML rather than written into a text
                # node, and it takes `Markup` and nothing else — `Prose
                # post.title` is a compile error, and so is `Text post.body`.
                Prose post.body, class is "prose"

# How far down the document the reader is, as a whole percent. `from
# scroll` is a source signal the browser writes — the same family as the
# clock, and nothing in this program may write it. `round` gives an
# `Option` because a `Decimal` can be infinite, so it is unwrapped once.
state travelled is client Decimal from scroll
state percent is client Whole from valueOr with maybe is (round of travelled), fallback is 0

# The tmux status line the real site opens with. Every piece is an
# element; the monospace and the amber tag are two classes.
# `sticky`, so the bar stays at the top while the document moves under it —
# which is what makes the percentage worth showing at all. Both words are in
# the style vocabulary, so this is the program saying it rather than the
# stylesheet: `position` takes a keyword and `sticky` is one of them.
# A tmux window is a number, a name, and a `*` when it is the current one.
# The four sections are anchors on the home page — `/about` and `/projects`
# are 404 on the real site, because they were never pages — and the fifth is
# a real document.
# Which window is current. `when` over the route, so a fifth page added
# later is a compile error here rather than a tab that never lights.
function isReading of spot
    when spot
        None
            give no
        Some with here
            when here
                Home
                    give no
                Writing
                    give yes
                Entry with slug
                    give yes
                Work with slug
                    give no

component Tab with number, name, target, here
    Link target, decoration is "none", padding is 0
        Row gap is 0, align is "baseline", class is (tabClass of here)
            Text number
            Text ":"
            Text name
            if here
                Text "*"

function tabClass of here
    if here
        give "tab tab-on"
    give "tab"

component Status with onBlog
    Row class is "status", position is "sticky", top is 0, layer is 10, padding is 8, gap is 14, align is "center"
        Link Home, decoration is "none", padding is 0
            Text "mark@portfolio", class is "tag", padding is 4
        Tab "0", "now", "/#now", (not onBlog)
        Tab "1", "about", "/#about", no
        Tab "2", "projects", "/#projects", no
        Tab "3", "range", "/#range", no
        # Written out rather than passed to `Tab`, because its destination is
        # a *route* and the other four are anchors. The compiler refuses
        # `"/blog"` here — "a destination has one phrasing, and the route is
        # the one that stays correct when the URL does not" — and it is right,
        # so the two cannot share one parameter.
        Link Writing, decoration is "none", padding is 0
            Row gap is 0, align is "baseline", class is (tabClass of onBlog)
                Text "4"
                Text ":"
                Text "blog"
                if onBlog
                    Text "*"
        Row grow is 1
        Row gap is 3, align is "center", class is "pct"
            Text percent
            Text "%"
        Text "[~]", class is "clock"
component Prompt with command
    Row gap is 8, align is "center", class is "prompt"
        Text "~/portfolio", class is "prompt-path"
        Text "$", class is "prompt-mark"
        Text command

# `// name`, with an optional count beside it.
# The `id` is what the status bar's tabs jump to: `/#now` is an anchor on
# this page, because the sections were never separate documents.
component SectionHead with name, count, anchor
    Row gap is 10, align is "baseline", class is "section-head", id is anchor
        Text ("// " + name)
        Text count, class is "section-count"

# One line of `now` or of `range`: a label, the thing, and the detail.
component LineItem with line
    Column gap is 3, padding is 12, class is "line"
        Text line.label, class is "line-label"
        Text line.title, class is "line-title"
        if not (isBlank of line.detail)
            Text line.detail, class is "line-detail"

# Five ticks, metal-first, lit for the layers this project reaches. The
# rarest lit tick is the leftmost, which is the point of showing it.
component DepthGauge with stack
    Row gap is 2, align is "center"
        each layer in layerNames
            Row class is (tickClass with stack is stack, layer is layer), width is 7, height is 14, radius is 1

# A project's state, as a shape rather than a hue. Colour alone cannot
# distinguish two states under WCAG 1.4.1, and three dots differing only in
# hue is exactly that — so a disc, a ring and a half-disc, with the word
# beside them regardless.
component StatusBadge with status
    Row gap is 6, align is "center"
        Row class is ("dot dot-" + status), width is 8, height is 8, radius is 999
        Text status, class is "status-word"

# The listing, not a card grid. Twelve cards is a lot of chrome to scroll
# past and rounded bordered cards are the one shape every site already has;
# a listing is denser, scans at once, and belongs to the same terminal world
# as the rest of the page.
component WorkRow with project
    Link (Work with slug is project.slug), decoration is "none", color is "ink"
        Row class is "row", padding is 18, gap is 20, align is "baseline", narrowDisplay is "block"
            Row width is 52, align is "center"
                DepthGauge project.stack
            Row width is 108
                StatusBadge project.status
            Column grow is 1, basis is 0, gap is 6, minWidth is 0
                Text project.title, class is "row-title"
                Text project.oneLiner, color is "muted", size is "small", lineHeight is 1.65
                Text project.stack, class is "stack"
            Text project.timeline, class is "effort"

component Working with project
    Column gap is 0
        Link Home, decoration is "none", padding is 0
            Row gap is 8, align is "center", class is "cd"
                Text "←", class is "cd-arrow"
                Text "cd ../projects"
        Article
            Column gap is 0
                Row height is 28
                Row gap is 10, align is "baseline", class is "meta"
                    Text project.status
                    if not (isBlank of project.timeline)
                        Text "·"
                    Text project.timeline
                Heading project.title, class is "title"
                Row height is 10
                Text project.oneLiner, color is "muted", size is "large", lineHeight is 1.6, maxWidth is 665
                Row height is 10
                Text project.stack, class is "stack"
                Row height is 30
                Prose project.body, class is "prose"

# One bar of the coverage chart. `width` is a percentage the build worked
# out, and it is written into the class rather than the style because a
# `Lengths` is pixels and a percentage cannot be one — so the widths are
# twenty-one classes in the stylesheet and the program names one.
component CoverageBar with row
    Row gap is 12, align is "center", class is "cov-row"
        Text row.layer, class is "cov-label"
        Row class is "cov-track", grow is 1, position is "relative"
            Row class is ("cov-fill cov-" + row.layer + " cov-w" + (text of (rounded5 of row.width)))
            Text row.count, class is "cov-count", position is "absolute", right is 8, top is 0

component Shell with onBlog, children
    Column class is "page", minHeight is 700
        Status onBlog
        Row justify is "center"
            Column maxWidth is 700, grow is 1, padding is 40, narrowPadding is 18, gap is 0
                children

view title is "Mark Sturman"
    # `Shell` sits inside each arm rather than around the `when`.
    # `address` is folded to one value per emitted document, so `page` may
    # only be dispatched on — reading it as an expression to work out which
    # tab is current is exactly what the compiler refuses, and the repair is
    # to let each arm say so with a literal.
    when page
        None
            Shell no
                Column gap is 10
                    Heading "Not found"
                    Link Writing, decoration is "none"
                        Text "back to writing", color is "accent"

        Some with here
            when here
                Home
                    Shell no
                        Column gap is 0
                            Row height is 48
                            Row gap is 8, align is "center", class is "prompt"
                                Text "~/portfolio", class is "prompt-path"
                                Text "$", class is "prompt-mark"
                                Text "whoami"
                                Row class is "caret", width is 8, height is 16

                            Heading "Mark.", class is "hero"

                            # Two-tone, as the original is: the claim is
                            # italic and grey and the verb is upright and
                            # amber, which is the whole joke of the line.
                            #
                            # `display is "block"`, not the default `Row`. A
                            # `Row` is a flex container and its children are
                            # flex items, and the trailing space in "makes
                            # models " is *collapsed away* between two items —
                            # the words ran together as "modelsrun". In block
                            # flow the spans are inline and the space is a
                            # space.
                            Row display is "block", class is "hero-sub"
                                Text "makes models "
                                Text "run faster", class is "hero-verb"
                                Text "."

                            Row height is 12
                            Text "Transformers written from scratch, DNN kernels hand scheduled in TVM across CPU, GPU and FPGA, and the Rust servers and iOS apps underneath. One person, the whole stack.", color is "muted", lineHeight is 1.7, maxWidth is 620, size is "large"

                            Row height is 24

                            # Two rankings, stated plainly and without a
                            # verification link: the repositories are private
                            # and a dead link reads worse than an unlinked
                            # claim.
                            Column gap is 8, class is "creds", padding is 12, maxWidth is 620
                                Row gap is 10, align is "baseline"
                                    Text "1st in class", class is "cred-rank"
                                    Text "Cornell ECE 5545, benchmarked TVM kernel optimization", class is "cred-detail"
                                Row gap is 10, align is "baseline"
                                    Text "1st in class", class is "cred-rank"
                                    Text "Cornell CS 5740, NLP held out test accuracy", class is "cred-detail"

                            Row height is 30
                            Row gap is 8, align is "center", class is "psst", padding is 12, radius is 8
                                Text "psst, this site has an interactive mode. Try pressing"
                                Text "~", class is "kbd", padding is 4

                            Row height is 46

                            # The measurement of the claim the hero just made.
                            Column gap is 10, class is "coverage", padding is 18, maxWidth is 620
                                Row gap is 10, align is "baseline", class is "cov-head"
                                    Text "stack coverage"
                                    Row grow is 1
                                    Text spanned, class is "cov-spanned"
                                    Text ("of " + (text of (listLength of layerNames)) + " layers")
                                Column gap is 3
                                    each row in coverage
                                        CoverageBar row
                                Text "Counted from each project's declared stack, metal at the top.", class is "cov-note"

                            Row height is 56

                            SectionHead "now", "", "now"
                            Row height is 10
                            Prompt "cat now.txt"
                            Row height is 10
                            Column gap is 2
                                each line in now
                                    LineItem line
                            Row height is 56

                            SectionHead "about", "", "about"
                            Row height is 18

                            # The lead: Instrument Serif at 36px with one
                            # phrase in italic amber, which is the shape of
                            # the section rather than decoration on it.
                            # Block flow for the same reason the hero's
                            # subtitle needs it: the spaces live inside the
                            # text, and a flex container eats them.
                            Row display is "block", class is "about-lead", maxWidth is 665
                                Text aboutOpen
                                Text aboutStress, class is "about-stress"
                                Text aboutClose

                            Row height is 20
                            Column gap is 20, maxWidth is 665
                                each paragraph in about
                                    Text paragraph, color is "muted", lineHeight is 1.75
                            Row height is 56

                            SectionHead "projects", "16 entries", "projects"
                            Row height is 14
                            Row class is "row-head", gap is 20, padding is 12, narrowDisplay is "none"
                                Row width is 52
                                    Text "depth"
                                Row width is 108
                                    Text "status"
                                Row grow is 1
                                    Text "project"
                                Text "effort"
                            Column gap is 0
                                each project in ranked
                                    WorkRow project
                            Row height is 56

                            SectionHead "range", "13 domains", "range"
                            Row height is 14
