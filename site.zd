# site.zd — the entry: the routes, the shell, and every view that links.
#
# WHAT THIS REPLACES. Next.js reads the same directory with `gray-matter`
# for the header and `next-mdx-remote` for the body, at request time or at
# ISR time, with `remark-gfm` in the pipeline. Here `build list`, `build
# read` and `build markdown` do it in the compiler, once, and what ships is
# HTML in a document. There is no markdown renderer in the bundle because
# there is no markdown left to render.
#
# WHAT THAT COSTS AND WHAT IT BUYS. It costs the ability to add a post
# without rebuilding — this is a `static` placement and `static` means the
# build host holds it. It buys a page that needs no JavaScript to show its
# text, a bundle with no parser in it, and a broken post that is a failed
# build rather than a blank page.
#
# THE ONE THING THAT IS NOT PORTABLE, AND WHAT IS BEING DONE ABOUT IT.
# MDX lets a post embed a React component, and nothing here can yet. Every
# file in `content/` is plain markdown today — checked, not assumed — so
# nothing is lost.
#
# The design is settled and written down in zdeceptron#305: a post stops
# being one `Markup` and becomes a *list of parts*, each either a run of
# prose or a named widget, so the document is an ordinary `each` and no
# parsed subtree ever shares a parent with a templated one. That last
# clause is the whole difficulty — it is why `Prose` has no children and
# cannot grow them, and it is why the answer is a list rather than an
# escape hatch inside the markup.
#
# The widget set is closed and the *program* declares it, so a post naming
# something the program does not offer is a failed build rather than a
# blank space. That is a stronger bargain than MDX makes, where an import
# inside a content file can reach anything on disk.

use "./posts" for Post, posts, ordered, missingPost, postWith, slugs
# The feed is `static` and emits its own file, so importing it is what puts
# `rss.xml` in this build rather than in a second one nobody runs.
use "./feed" for feed
use "./sitemap" for sitemap, robots
use "./llms" for llms
use "./widgets" for Widget, DeepStackOf, MemoryLadderOf
use "./rings" for trunkOutlines,
    grain,
    pithPath,
    trunkExtent,
    viewBoxText,
    FIRST_YEAR,
    lastYear,
    workingYears,
    totalCommits
use "./projects" for Project,
    Listing,
    cards,
    projects,
    ranked,
    missingProject,
    projectWith,
    effortOf,
    Coverage,
    coverage,
    spanned,
    projectSlugs,
    rounded5
use "./data" for Line, now, about, aboutOpen, aboutStress, aboutClose, focus, domains
use "./layers" for layerNames, reaches, oneIfReaches, tickClass
use "./terminal" for screen,
    dinoTop,
    dinoBest,
    line,
    open,
    mode,
    overlay,
    pegs,
    lex,
    ship,
    board,
    running,
    field,
    tiles,
    bestScore,
    serpent,
    stack,
    runner,
    crawling,
    deepest,
    lab,
    labCaught,
    labGrowth,
    beat,
    history,
    cursor,
    draft,
    promptFor,
    hintFor,
    joined,
    opening,
    recalled,
    steppedBack
use "./commands" for runCommand, completionFor
use "./codebreak" for Pegs, Round, newPegs, stepPegs
use "./lexer" for Lex, Reply, newLex, stepLex
use "./trader" for Ship, Move, newShip, stepTrader
use "./critters" for CritterGame, CritterGrowth, critterNewGame, critterWalk, critterAct, critterMenuMoved, critterConfirm, critterViewBox, critterTerrainLayers, critterTerrainPath, critterTerrainFill, critterHeroPath, critterHeroEyePath, critterExploreLine, critterExploreTally, critterBattleLog, critterFoeHeadline, critterFoeTag, critterFoeStars, critterAllyHeadline, critterAllyStatsLine, critterFoeCardPath, critterAllyCardPath, critterFoeBarTrackPath, critterFoeBarFillPath, critterAllyBarTrackPath, critterAllyBarFillPath, critterMenuPath, critterMenuText, critterMenuActive, critterActionSlots
use "./snake" for Snake, newSnake, snakeSteer, snakeStatus, snakeViewBox, snakePortalPath, snakeFoodPath, snakeStemPath, snakeBodyPath, snakeGlintPath, snakeHeadPath, snakeEyesPath, snakeBodyFill, snakeHeadFill
use "./blocks" for Blocks, newBlocks, blocksLeft, blocksRight, blocksDown, blocksRotate, blocksDrop, blocksRefactor, blocksStatus, blocksViewBox, blocksNextViewBox, blocksColor, blocksTilePath, blocksGhostPath, blocksGridPath, blocksNextPath, blocksNextColor, blocksPieceColor
use "./dungeon" for Crawl, crawlStart, crawlStep, crawlStatus, crawlGearLine, crawlRecent, crawlViewBox, crawlFloorPath, crawlFloorDimPath, crawlWallPath, crawlWallDimPath, crawlStairsPath, crawlCoinPath, crawlPotionPath, crawlGearPath, crawlShinePath, crawlGemPath, crawlHurtPath, crawlFoePath, crawlMerchantPath, crawlHeroPath, crawlTrimPath, crawlEyePath
use "./dino" for Dino, dinoFresh, dinoJump, dinoScore, dinoStatus, dinoViewBox, dinoBodyColour, dinoPupilColour, dinoCloudPath, dinoGroundPath, dinoRockPath, dinoRockLitPath, dinoRockShadePath, dinoBodyPath, dinoLitPath, dinoShadePath, dinoEyePath, dinoPupilPath
use "./game2048" for Board, Direction, cellOf, afterMove, freshBoard, tileClass, tileText
use "./mines" for Field,
    freshField,
    revealAt,
    flagAt,
    movedBy,
    mineStatus,
    mineViewBox,
    hiddenPath,
    flaggedPath,
    openPath,
    cursorPath,
    minePath
use "./life" for Life,
    stepLife,
    stamped,
    population,
    boardPath,
    lifeViewBox,
    gunCells,
    gliderCells,
    pulsarCells

route Site
    Home    is "/"
    Writing is "/blog"
    Entry   is "/blog" with slug is Text in slugs
    Work    is "/projects" with slug is Text in projectSlugs

state page is client Option of Site starting address

# Read at compile time and inlined. No boundary is crossed at run time, so
# this is a `List of Post` and not a `Remote of List of Post`.
# --- the view --------------------------------------------------------------

component Card with post
    Link (Entry with slug is post.slug), decoration is "none", color is "ink"
        Column class is "card", padding is 20, gap is 8
            Row gap is 6, align is "center", class is "meta"
                Text post.date
                Text "·"
                Text post.minutes
                Text "min read"
            Heading post.title, class is "card-title"
            Text post.summary, color is "muted", size is "small", lineHeight is 1.7

component Crumb
    Row gap is 8, align is "center", class is "cd"
        Text "←", class is "cd-arrow"
        Text "cd ../blog"

component Reading with post
    Column gap is 0
        Link Writing, decoration is "none", padding is 0
            Crumb
        Article
            Column gap is 0, padding is 0
                Row height is 28
                Row gap is 6, align is "center", class is "meta"
                    Text post.date
                    Text "·"
                    Text post.minutes
                    Text "min read"
                Heading post.title, class is "title"
                Row height is 34
                # The body, rendered. `Prose` is the only element whose
                # argument is parsed as HTML rather than written into a text
                # node, and it takes `Markup` and nothing else — `Prose
                # post.title` is a compile error, and so is `Text post.body`.
                Prose post.body, class is "prose"

# How far down the document the reader is, as a whole percent. `from
# scroll` is a source signal the browser writes — the same family as the
# clock, and nothing in this program may write it. `round` gives an
# `Option` because a `Decimal` can be infinite, so it is unwrapped once.
state travelled is client Decimal from scroll
state percent is client Whole from valueOr with maybe is (round of travelled), fallback is 0

# The tmux status line the real site opens with. Every piece is an
# element; the monospace and the amber tag are two classes.
# `sticky`, so the bar stays at the top while the document moves under it —
# which is what makes the percentage worth showing at all. Both words are in
# the style vocabulary, so this is the program saying it rather than the
# stylesheet: `position` takes a keyword and `sticky` is one of them.
# A tmux window is a number, a name, and a `*` when it is the current one.
# The four sections are anchors on the home page — `/about` and `/projects`
# are 404 on the real site, because they were never pages — and the fifth is
# a real document.
# Which window is current. `when` over the route, so a fifth page added
# later is a compile error here rather than a tab that never lights.
function isReading of spot
    when spot
        None
            give no
        Some with here
            when here
                Home
                    give no
                Writing
                    give yes
                Entry with slug
                    give yes
                Work with slug
                    give no

component Tab with number, name, target, here
    Link target, decoration is "none", padding is 0
        Row gap is 0, align is "baseline", class is (tabClass of here)
            Text number
            Text ":"
            Text name
            if here
                Text "*"

function tabClass of here
    if here
        give "tab tab-on"
    give "tab"

component Status with onBlog
    Row class is "status",
        position is "sticky",
        top is 0,
        layer is 10,
        padding is 8,
        gap is 14,
        align is "center"
        Link Home, decoration is "none", padding is 0
            Text "mark@portfolio", class is "tag", padding is 4
        Tab "0", "now", "/#now", (not onBlog)
        Tab "1", "about", "/#about", no
        Tab "2", "projects", "/#projects", no
        Tab "3", "range", "/#range", no
        # Written out rather than passed to `Tab`, because its destination is
        # a *route* and the other four are anchors. The compiler refuses
        # `"/blog"` here — "a destination has one phrasing, and the route is
        # the one that stays correct when the URL does not" — and it is right,
        # so the two cannot share one parameter.
        Link Writing, decoration is "none", padding is 0
            Row gap is 0, align is "baseline", class is (tabClass of onBlog)
                Text "4"
                Text ":"
                Text "blog"
                if onBlog
                    Text "*"
        Row grow is 1
        Row gap is 3, align is "center", class is "pct"
            Text percent
            Text "%"
        Text "[~]", class is "clock"
component Prompt with command
    Row gap is 8, align is "center", class is "prompt print-in"
        Text "~/portfolio", class is "prompt-path"
        Text "$", class is "prompt-mark"
        Text command

# `// name`, with an optional count beside it.
# The `id` is what the status bar's tabs jump to: `/#now` is an anchor on
# this page, because the sections were never separate documents.
component SectionHead with name, count, anchor
    Row gap is 10, align is "baseline", class is "section-head", id is anchor
        Text ("// " + name)
        Text count, class is "section-count"

# One line of `now` or of `range`: a label, the thing, and the detail.
component LineItem with line
    Column gap is 3, padding is 12, class is "line"
        Text line.label, class is "line-label"
        Text line.title, class is "line-title"
        if not (isBlank of line.detail)
            Text line.detail, class is "line-detail"

# One row of the range spec sheet: the domain, what it covers, and what it
# is written in. Three columns rather than a stack, so the languages line up
# in their own column and the repeats across rows — Rust, TypeScript, Swift —
# are visible by scanning down rather than being claimed.
component RangeRow with line, tier
    Row class is ("range-row " + tier)
        Text line.label, class is "range-area"
        Text line.title, class is "range-detail"
        Text line.detail, class is "range-langs"

# Five ticks, metal-first, lit for the layers this project reaches. The
# rarest lit tick is the leftmost, which is the point of showing it.
component DepthGauge with stack
    Row gap is 2, align is "center"
        each layer in layerNames
            Row class is (tickClass with stack is stack, layer is layer)

# A project's state, as a shape rather than a hue. Colour alone cannot
# distinguish two states under WCAG 1.4.1, and three dots differing only in
# hue is exactly that — so a disc, a ring and a half-disc, with the word
# beside them regardless.
component StatusBadge with status
    Row gap is 6, align is "center"
        Row class is ("dot dot-" + status), width is 8, height is 8, radius is 999
        Text status, class is "status-word"

# The listing, not a card grid. Twelve cards is a lot of chrome to scroll
# past and rounded bordered cards are the one shape every site already has;
# a listing is denser, scans at once, and belongs to the same terminal world
# as the rest of the page.
# A four-column grid: 3.25rem for the depth ticks, 7rem for the status,
# everything left for the project, and the effort sized to itself. The
# template lives in the stylesheet because `display` in the style vocabulary
# names `block`, `inline`, `inlineBlock` and `none` — there is no `grid`
# keyword, and a grid template is a second grammar besides.
component WorkRow with project
    Link (Work with slug is project.slug), decoration is "none", color is "ink"
        Row class is "row"
            Row class is "row-depth"
                DepthGauge project.stack
            Row class is "row-status"
                StatusBadge project.status
            Column class is "row-main"
                Text project.title, class is "row-title"
                Text project.oneLiner, class is "row-line"
                Text project.shown, class is "row-stack"
            Text (effortOf of project.timeline), class is "row-effort"

component Working with project
    Column gap is 0
        Link Home, decoration is "none", padding is 0
            Row gap is 8, align is "center", class is "cd"
                Text "←", class is "cd-arrow"
                Text "cd ../projects"
        Article
            Column gap is 0
                Row height is 28
                Row gap is 10, align is "baseline", class is "meta"
                    Text project.status
                    if not (isBlank of project.timeline)
                        Text "·"
                    Text project.timeline
                Heading project.title, class is "title"
                Row height is 10
                Text project.oneLiner,
                    color is "muted",
                    size is "large",
                    lineHeight is 1.6,
                    maxWidth is 665
                Row height is 10
                Text project.shown, class is "stack"
                Row height is 30
                each part in project.parts
                    if isBlank of part.widget
                        Prose part.markup, class is "prose"
                    if part.widget is "DeepStack"
                        DeepStackOf part.argument
                    if part.widget is "MemoryLadder"
                        MemoryLadderOf

# One bar of the coverage chart. `width` is a percentage the build worked
# out, and it is written into the class rather than the style because a
# `Lengths` is pixels and a percentage cannot be one — so the widths are
# twenty-one classes in the stylesheet and the program names one.
component CoverageBar with row
    Row gap is 12, align is "center", class is "cov-row"
        Text row.layer, class is "cov-label"
        Row class is "cov-track", grow is 1, position is "relative"
            Row class is ("cov-fill cov-" + row.layer + " cov-w" + (text of (rounded5 of row.width)))
            Text row.count, class is "cov-count", position is "absolute", right is 8, top is 0

# The terminal overlay. `on key "~"` sits beside the elements because it
# listens to the document, and the compiled listener stands down while a
# field has focus — so typing `~` into the terminal's own input does not
# close it, and nothing here says so.
# The overlay itself. The `~` that opens it is declared at the top of the
# view rather than here: `on key` goes beside the elements, and a component
# whose body is a listener *and* a branch is two things where the production
# wants one.
component Terminal
    if open
        Column class is "term",
            position is "fixed",
            top is 0,
            left is 0,
            right is 0,
            bottom is 0,
            layer is 50,
            padding is 24
            Column class is "term-body",
                grow is 1,
                padding is 18,
                gap is 4,
                overflow is "scroll"
                each printed in screen
                    Text printed, class is "term-line"

            # A game that takes the panel. It sits above the prompt rather
            # than replacing it, so the scrollback behind stays readable
            # and `esc` has somewhere to go back to.
            if overlay is "life"
                Column class is "term-game-wide", gap is 8
                    Row gap is 16, align is "center"
                        Text "conway", class is "prompt-path"
                        Text (("generation " + (text of board.generation)) + " · population ") + (text of (population of board)),
                            class is "prompt-mark"
                        Text "space runs · n steps · g gun · p pulsar · esc quits",
                            class is "prompt-mark"
                    Scene viewBox is lifeViewBox, label is "Conway's game of life"
                        Path outline is (boardPath of board), fill is "#ffa96b"

                # The same keys, on the document. The handlers on the
                # terminal's input fire only while that field has focus,
                # and a reader who clicks the board has just taken it
                # away. `on key` stands down while a field has focus, so
                # exactly one of the pair runs and a press is never
                # counted twice.
                on key " "
                    set running to not running
                on key "n"
                    set board to (stepLife of board)
                on key "g"
                    set board to (
                        stamped with pattern is gunCells,
                        seed is board.seed)
                on key "p"
                    set board to (
                        stamped with pattern is pulsarCells,
                        seed is board.seed)
                on key "c"
                    set board to (
                        stamped with pattern is gliderCells,
                        seed is board.seed)

            # Two screens, and which one is up is a fact the game already
            # holds: `hunt.foe` is `Some` exactly while a battle is on. So
            # this is a `when` over that option rather than a second overlay
            # name — the terminal never has to know a battle started, and
            # cannot disagree with the game about whether one is happening.
            if overlay is "critters"
                Column class is "term-game-wide", gap is 8, align is "center"
                    when lab.hunt.foe
                        None
                            Column gap is 8, align is "center"
                                Row gap is 16, align is "center"
                                    Text "critter lab", class is "prompt-path"
                                    Text (critterExploreLine of lab), class is "prompt-mark"
                                Scene viewBox is critterViewBox, label is "the critter lab"
                                    each layer in critterTerrainLayers
                                        Path outline is (critterTerrainPath with world is lab.world, layer is layer, time is beat), fill is (critterTerrainFill of layer)
                                    Path outline is (critterHeroPath with world is lab.world, time is beat), fill is "#e6c46d"
                                    Path outline is (critterHeroEyePath with world is lab.world, time is beat), fill is "#15100d"
                                Text (critterExploreTally of lab), class is "prompt-mark"
                        Some with foe
                            Column gap is 8, align is "center"
                                Row gap is 16, align is "center"
                                    Text (critterFoeHeadline of foe), class is "prompt-path"
                                    Text (critterFoeStars of foe), class is "prompt-mark"
                                    Text (critterFoeTag of foe), class is "prompt-mark"
                                # The cards, the two health bars and the four
                                # menu boxes. A `Scene` may hold none of the
                                # words, so every label is a `Text` beside it
                                # — the same division `mines.zd` argues for
                                # its glyphs.
                                Scene viewBox is critterViewBox, label is "a critter battle"
                                    Path outline is (critterFoeCardPath), fill is "#1a1512"
                                    Path outline is (critterAllyCardPath), fill is "#1a1512"
                                    Path outline is (critterFoeBarTrackPath), fill is "#2b261e"
                                    Path outline is (critterFoeBarFillPath of foe), fill is "#e06a5a"
                                    Path outline is (critterAllyBarTrackPath), fill is "#2b261e"
                                    Path outline is (critterAllyBarFillPath of lab.hunt), fill is "#86dcb8"
                                    each slot in critterActionSlots
                                        Path outline is (critterMenuPath of slot),
                                            fill is "none",
                                            stroke is (
                                                "#ffa96b" if (
                                                    critterMenuActive with game is lab,
                                                    index is slot) otherwise "#2b261e"),
                                            strokeWidth is 2
                                Text (critterAllyHeadline of lab.hunt), class is "prompt-mark"
                                Text (critterAllyStatsLine of lab.hunt), class is "prompt-mark"
                                Row gap is 14, align is "center"
                                    each slot in critterActionSlots
                                        Text (critterMenuText of slot),
                                            class is "prompt-mark",
                                            weight is (
                                                "800" if (
                                                    critterMenuActive with game is lab,
                                                    index is slot) otherwise "400")
                                Column gap is 2
                                    each said in (critterBattleLog of lab)
                                        Text said, class is "term-line"
                # The same keys, on the document, for the reason the other
                # games carry. The guard moves *inside* the handler rather
                # than around it: `on key` names one key and sits beside an
                # element, so the two meanings of an arrow — walking the
                # world, and moving the action cursor once something has
                # found you — are one listener that asks which it is. That
                # is the same question `isNone of lab.hunt.foe` answers in
                # the input handler, and asking it in both places is what
                # keeps the panel and the game agreeing.
                on key "ArrowLeft"
                    if isNone of lab.hunt.foe
                        set lab to (critterWalk with game is lab, dir is "left")
                    if isSome of lab.hunt.foe
                        set lab to (critterMenuMoved with game is lab, step is 3)
                on key "ArrowRight"
                    if isNone of lab.hunt.foe
                        set lab to (critterWalk with game is lab, dir is "right")
                    if isSome of lab.hunt.foe
                        set lab to (critterMenuMoved with game is lab, step is 1)
                on key "ArrowUp"
                    if isNone of lab.hunt.foe
                        set lab to (critterWalk with game is lab, dir is "up")
                    if isSome of lab.hunt.foe
                        set lab to (critterMenuMoved with game is lab, step is 2)
                on key "ArrowDown"
                    if isNone of lab.hunt.foe
                        set lab to (critterWalk with game is lab, dir is "down")
                    if isSome of lab.hunt.foe
                        set lab to (critterMenuMoved with game is lab, step is 2)
                on key " "
                    if isSome of lab.hunt.foe
                        set lab to (critterConfirm of lab)
                on key "Enter"
                    if isSome of lab.hunt.foe
                        set lab to (critterConfirm of lab)

            if overlay is "snake"
                Column class is "term-game", gap is 8, align is "center"
                    Row gap is 16, align is "center"
                        Text "snake", class is "prompt-path"
                        Text (snakeStatus of serpent), class is "prompt-mark"
                    Scene viewBox is snakeViewBox, label is "snake"
                        Path outline is (snakePortalPath of serpent), fill is "none", stroke is "#86dcb8", strokeWidth is 2
                        Path outline is (snakeStemPath of serpent), fill is "none", stroke is "#6b8f3a", strokeWidth is 2
                        Path outline is (snakeFoodPath of serpent), fill is "#e6c46d"
                        Path outline is (snakeBodyPath of serpent), fill is (snakeBodyFill of serpent)
                        Path outline is (snakeGlintPath of serpent), fill is "#ffffff", opacity is 0.12
                        Path outline is (snakeHeadPath of serpent), fill is (snakeHeadFill of serpent)
                        Path outline is (snakeEyesPath of serpent), fill is "#15100d"

                # The same keys, on the document. The handlers on the
                # terminal's input fire only while that field has focus,
                # and a reader who clicks the board has just taken it
                # away. `on key` stands down while a field has focus, so
                # exactly one of the pair runs and a press is never
                # counted twice.
                on key "ArrowLeft"
                    set serpent to (snakeSteer with game is serpent, dx is 0 - 1, dy is 0)
                on key "ArrowRight"
                    set serpent to (snakeSteer with game is serpent, dx is 1, dy is 0)
                on key "ArrowUp"
                    set serpent to (snakeSteer with game is serpent, dx is 0, dy is 0 - 1)
                on key "ArrowDown"
                    set serpent to (snakeSteer with game is serpent, dx is 0, dy is 1)
                on key " "
                    set serpent to (newSnake of (clock))

            if overlay is "blocks"
                Column class is "term-game-wide", gap is 8, align is "center"
                    Row gap is 16, align is "center"
                        Text "blocks", class is "prompt-path"
                        Text (blocksStatus of stack), class is "prompt-mark"
                    Row gap is 14, align is "start"
                        Scene viewBox is blocksViewBox, label is "blocks"
                            Path outline is (blocksGridPath), fill is "none", stroke is "#2b261e", strokeWidth is 1
                            each kind in [1, 2, 3, 4, 5, 6, 7]
                                Path outline is (blocksTilePath with game is stack, kind is kind), fill is (blocksColor of kind)
                            Path outline is (blocksGhostPath of stack), fill is "none", stroke is (blocksPieceColor of stack), strokeWidth is 1
                        Column gap is 6
                            Text "next", class is "prompt-mark"
                            Scene viewBox is blocksNextViewBox, label is "the next piece"
                                Path outline is (blocksNextPath of stack), fill is (blocksNextColor of stack)

                # The same keys, on the document. The handlers on the
                # terminal's input fire only while that field has focus,
                # and a reader who clicks the board has just taken it
                # away. `on key` stands down while a field has focus, so
                # exactly one of the pair runs and a press is never
                # counted twice.
                on key "ArrowLeft"
                    set stack to (blocksLeft of stack)
                on key "ArrowRight"
                    set stack to (blocksRight of stack)
                on key "ArrowDown"
                    set stack to (blocksDown of stack)
                on key "ArrowUp"
                    set stack to (blocksRotate of stack)
                on key " "
                    set stack to (blocksDrop of stack)
                on key "r"
                    set stack to (blocksRefactor of stack)

            # Sixteen paths in the order the original's canvas fills
            # them: the remembered map underneath, the lit map over it,
            # then what is lying on the floor, then what is alive.
            #
            # A gem is violet where the original gives every legendary a
            # hue of its own. One hue per item is one fill per item is one
            # *path* per item, which is the thing the single-path rule
            # exists to prevent — and gold, the original's colour for an
            # ordinary gem, was the wrong thing to collapse to: a gem
            # drawn the colour of the coins beside it is a gem nobody
            # sees.
            if overlay is "crawl"
                Column class is "term-game-wide", gap is 8
                    Row gap is 16, align is "center"
                        Text "crawl", class is "prompt-path"
                        Text (crawlStatus of crawling), class is "prompt-mark"
                    Row gap is 16, align is "center"
                        Text (crawlGearLine of crawling), class is "prompt-mark"
                        Text "deepest floor " + (text of deepest), class is "prompt-mark"
                    Scene viewBox is crawlViewBox, label is "a dungeon floor"
                        Path outline is (crawlFloorDimPath of crawling), fill is "#100e0b"
                        Path outline is (crawlWallDimPath of crawling), fill is "#141210"
                        Path outline is (crawlFloorPath of crawling), fill is "#171410"
                        Path outline is (crawlWallPath of crawling), fill is "#2b261e"
                        Path outline is (crawlStairsPath of crawling),
                            fill is "none",
                            stroke is "#ffa96b",
                            strokeWidth is 2
                        Path outline is (crawlCoinPath of crawling), fill is "#e6c46d"
                        Path outline is (crawlPotionPath of crawling), fill is "#86dcb8"
                        Path outline is (crawlGearPath of crawling), fill is "#c9c3b4"
                        Path outline is (crawlShinePath of crawling), fill is "#ffa96b"
                        Path outline is (crawlGemPath of crawling), fill is "#c792ea"
                        Path outline is (crawlHurtPath of crawling), fill is "#e06a5a"
                        Path outline is (crawlFoePath of crawling), fill is "#e06a5a"
                        Path outline is (crawlMerchantPath of crawling), fill is "#e6c46d"
                        Path outline is (crawlHeroPath of crawling), fill is "#ffa96b"
                        Path outline is (crawlTrimPath of crawling), fill is "#f2ede3"
                        Path outline is (crawlEyePath of crawling), fill is "#1a1512"
                    Column gap is 2
                        each entry in (crawlRecent of crawling)
                            Text entry, class is "term-line"

                # The same keys, on the document. The handlers on the
                # terminal's input fire only while that field has focus,
                # and a reader who clicks the board has just taken it
                # away. `on key` stands down while a field has focus, so
                # exactly one of the pair runs and a press is never
                # counted twice.
                on key "ArrowLeft"
                    set crawling to (
                        crawlStep with game is crawling,
                        dx is 0 - 1,
                        dy is 0)
                on key "ArrowRight"
                    set crawling to (crawlStep with game is crawling, dx is 1, dy is 0)
                on key "ArrowUp"
                    set crawling to (
                        crawlStep with game is crawling,
                        dx is 0,
                        dy is 0 - 1)
                on key "ArrowDown"
                    set crawling to (crawlStep with game is crawling, dx is 0, dy is 1)
                    set crawling to (crawlStart of (clock))
                    set deepest to crawling.depth

            if overlay is "dino"
                Column class is "term-game-wide", gap is 8, align is "center"
                    Row gap is 16, align is "center"
                        Text "dino", class is "prompt-path"
                        Text (dinoStatus of runner), class is "prompt-mark"
                        Text "best " + (text of (
                            max with first is dinoBest,
                            second is dinoTop)),
                            class is "prompt-mark"
                    Scene viewBox is dinoViewBox, label is "an endless runner"
                        Path outline is (dinoCloudPath of runner),
                            fill is "#aaa295",
                            opacity is 0.22
                        Path outline is (dinoGroundPath of runner), fill is "#aaa295"
                        Path outline is (dinoRockPath of runner), fill is "#79b98a"
                        Path outline is (dinoRockLitPath of runner),
                            fill is "#ffffff",
                            opacity is 0.2
                        Path outline is (dinoRockShadePath of runner),
                            fill is "#000000",
                            opacity is 0.28
                        Path outline is (dinoBodyPath of runner), fill is (dinoBodyColour of runner)
                        Path outline is (dinoLitPath of runner),
                            fill is "#ffffff",
                            opacity is 0.18
                        Path outline is (dinoShadePath of runner),
                            fill is "#000000",
                            opacity is 0.22
                        Path outline is (dinoEyePath of runner), fill is "#f2ede3"
                        Path outline is (dinoPupilPath of runner),
                            fill is (dinoPupilColour of runner)

                # The same keys, on the document. The handlers on the
                # terminal's input fire only while that field has focus,
                # and a reader who clicks the board has just taken it
                # away. `on key` stands down while a field has focus, so
                # exactly one of the pair runs and a press is never
                # counted twice.
                on key " "
                    if runner.dead
                        set runner to (dinoFresh of (clock))
                    if not runner.dead
                        set runner to (dinoJump of runner)
                    set dinoBest to dinoTop

            if overlay is "2048"
                Column class is "term-game", gap is 8, align is "center"
                    Row gap is 16, align is "center"
                        Text "2048", class is "prompt-path"
                        Text ((("score " + (text of tiles.score)) + " · best ") + (text of bestScore)) + " · arrows slide · r restarts",
                            class is "prompt-mark"
                    Column class is "t48-grid", padding is 8, radius is 12
                        each band in [0, 4, 8, 12]
                            Row gap is 6
                                each step in [0, 1, 2, 3]
                                    Column class is (tileClass of (
                                        cellOf with cells is tiles.cells,
                                        index is band + step)),
                                        width is 62,
                                        height is 62,
                                        radius is 6,
                                        align is "center",
                                        justify is "center"
                                        Text (tileText of (
                                            cellOf with cells is tiles.cells,
                                            index is band + step)),
                                            weight is "800"
                # The same four moves, on the document. The handlers on the
                # terminal's input fire only while that field has focus, and
                # a reader who clicks the board to look at it has just taken
                # it away — after which the game stopped answering arrows at
                # all. `on key` is the other half of that pair by
                # construction: §14's listener *stands down* while a field
                # has focus, so exactly one of the two runs and a move is
                # never counted twice.
                on key "ArrowLeft"
                    set tiles to (afterMove with board is tiles, direction is Left)
                on key "ArrowRight"
                    set tiles to (afterMove with board is tiles, direction is Right)
                on key "ArrowUp"
                    set tiles to (afterMove with board is tiles, direction is Up)
                on key "ArrowDown"
                    set tiles to (afterMove with board is tiles, direction is Down)

                # `wasd` because the launch message promises it. Only on the
                # document: a reader pressing `a` to slide left is not typing
                # a command, and a reader who *is* typing gets the letter,
                # because `on key` stands down while the field has focus.
                on key "a"
                    set tiles to (afterMove with board is tiles, direction is Left)
                on key "d"
                    set tiles to (afterMove with board is tiles, direction is Right)
                on key "w"
                    set tiles to (afterMove with board is tiles, direction is Up)
                on key "s"
                    set tiles to (afterMove with board is tiles, direction is Down)

            if overlay is "minesweeper"
                Column class is "term-game-wide", gap is 8
                    Row gap is 16, align is "center"
                        Text "minesweeper", class is "prompt-path"
                        Text (mineStatus of field), class is "prompt-mark"
                    Scene viewBox is mineViewBox, label is "minesweeper"
                        Path outline is (openPath of field), fill is "#241c16"
                        Path outline is (hiddenPath of field), fill is "#3a3128"
                        Path outline is (flaggedPath of field), fill is "#e6c46d"
                        Path outline is (minePath of field), fill is "#ff6b6b"
                        Path outline is (cursorPath of field),
                            fill is "none",
                            stroke is "#ffa96b",
                            strokeWidth is 2

                # The same keys, on the document. The handlers on the
                # terminal's input fire only while that field has focus,
                # and a reader who clicks the board has just taken it
                # away. `on key` stands down while a field has focus, so
                # exactly one of the pair runs and a press is never
                # counted twice.
                on key "ArrowLeft"
                    set field to (movedBy with field is field, dx is 0 - 1, dy is 0)
                on key "ArrowRight"
                    set field to (movedBy with field is field, dx is 1, dy is 0)
                on key "ArrowUp"
                    set field to (movedBy with field is field, dx is 0, dy is 0 - 1)
                on key "ArrowDown"
                    set field to (movedBy with field is field, dx is 0, dy is 1)

                # The same promise, in this game's own message.
                on key "a"
                    set field to (movedBy with field is field, dx is 0 - 1, dy is 0)
                on key "d"
                    set field to (movedBy with field is field, dx is 1, dy is 0)
                on key "w"
                    set field to (movedBy with field is field, dx is 0, dy is 0 - 1)
                on key "s"
                    set field to (movedBy with field is field, dx is 0, dy is 1)
                    set field to (
                        revealAt with field is field,
                        index is field.cursor)
                on key "f"
                    set field to (flagAt with field is field, index is field.cursor)
                on key "r"
                    set field to (freshField of (clock))

            Row class is "term-input", gap is 8, align is "center", padding is 12
                Text "~/portfolio", class is "prompt-path"
                Text (promptFor of mode), class is "prompt-mark"
                Input line, hint is (hintFor of mode), class is "term-field", grow is 1
                    # Every binding a person who lives in a shell will try.
                    # They are written here rather than in `terminal.zd`
                    # because each one *writes* state, and a function in
                    # this language gives a value and writes nothing.
                    on keydown with stroke
                        if stroke.key is "Enter"
                            set screen to (append ((promptFor of mode) + " ") + line to screen)
                            set history to (append line to history)
                            set cursor to 0
                            set draft to ""
                            # A game holding the prompt takes the line
                            # instead of the shell. `mode` is the whole of
                            # that decision, so there is no second place
                            # for a line to go and no order to get wrong.
                            if mode is "codebreak"
                                with played is (stepPegs with game is pegs, input is line)
                                set pegs to played.game
                                set screen to (
                                    joined with head is screen,
                                    rest is played.printed)
                                if played.done
                                    set mode to "shell"
                            if mode is "lexer"
                                with guessed is (stepLex with game is lex, input is line)
                                set lex to guessed.game
                                set screen to (
                                    joined with head is screen,
                                    rest is guessed.printed)
                                if guessed.done
                                    set mode to "shell"
                            if mode is "trader"
                                with flown is (stepTrader with ship is ship, input is line)
                                set ship to flown.ship
                                set screen to (
                                    joined with head is screen,
                                    rest is flown.printed)
                                if flown.done
                                    set mode to "shell"
                            if mode is "games"
                                set mode to "shell"
                                with answer is (runCommand of line)
                                set screen to (
                                    joined with head is screen,
                                    rest is answer.printed)
                                if not (isBlank of answer.launches)
                                    set overlay to answer.launches
                                if not (isBlank of answer.enters)
                                    set mode to answer.enters
                            if mode is "shell"
                                with answer is (runCommand of line)
                                if answer.clears
                                    set screen to (opening)
                                if not answer.clears
                                    set screen to (
                                        joined with head is screen,
                                        rest is answer.printed)
                                if not (isBlank of answer.launches)
                                    set overlay to answer.launches
                                if answer.launches is "minesweeper"
                                    set field to (freshField of (clock))
                                if answer.launches is "2048"
                                    set tiles to (freshBoard of (clock))
                                if answer.launches is "snake"
                                    set serpent to (newSnake of (clock))
                                if answer.launches is "blocks"
                                    set stack to (newBlocks of (clock))
                                if answer.launches is "critters"
                                    set lab to (critterNewGame with caught is labCaught, growth is labGrowth, badges is 0, seed is (clock))
                                if not (isBlank of answer.enters)
                                    set mode to answer.enters
                                # A fresh code per game, seeded from the
                                # clock: a literal would deal every reader
                                # the same four pegs on every load.
                                if answer.enters is "codebreak"
                                    set pegs to (newPegs of (clock))
                                if answer.enters is "lexer"
                                    set lex to (newLex of (clock))
                                if answer.enters is "trader"
                                    set ship to (newShip of (clock))
                            set line to ""

                        # Ctrl+L clears the scrollback. Ctrl+C abandons the
                        # half-typed line without running it, and in a game
                        # mode drops back to the shell — which is what
                        # interrupting is for.
                        if stroke.control and ((stroke.key is "l") or (stroke.key is "L"))
                            set screen to (opening)
                            set line to ""
                        if stroke.control and ((stroke.key is "c") or (stroke.key is "C"))
                            set screen to (append (((promptFor of mode) + " ") + line) + "^C" to screen)
                            set line to ""
                            set mode to "shell"

                        # Up and down walk history — but only while no game
                        # holds the panel. Every game below steers with the
                        # arrows, and without this guard one press both
                        # moved the piece and recalled a command into the
                        # box underneath it: two things happening for one
                        # keystroke, one of them invisible until the reader
                        # pressed Enter on a line they never typed.
                        if isBlank of overlay
                            if stroke.key is "ArrowUp"
                                if cursor is 0
                                    set draft to line
                                set cursor to (steppedBack with all is history, position is cursor)
                                set line to (
                                    recalled with all is history,
                                    back is (steppedBack with all is history, position is cursor))
                            if stroke.key is "ArrowDown"
                                if cursor < 2
                                    set cursor to 0
                                    set line to draft
                                if cursor > 1
                                    set cursor to cursor - 1
                                    set line to (recalled with all is history, back is cursor - 1)

                        # Tab completes. More than one candidate prints the
                        # list, which is what a shell does rather than
                        # cycling silently through them.
                        if stroke.key is "Tab"
                            with completion is (completionFor of line)
                            set line to completion.completed
                            if (listLength of completion.suggestions) > 1
                                set screen to (append (
                                    join with parts is completion.suggestions,
                                    using is "  ") to screen)

                        # A game holding the panel takes the keys that
                        # drive it. They are on the input rather than on
                        # the document for the reason `on key` is: a
                        # document listener stands down while a field has
                        # focus, and the field always has it here.
                        # The same four arrows mean two things, and the game
                        # decides which: walking the world while nothing has
                        # found you, moving the action cursor once something
                        # has. Asking `isNone of lab.hunt.foe` rather than
                        # keeping a mode of our own is what stops the panel
                        # and the game disagreeing about whether a battle is
                        # on — the bug that had arrows both steering a piece
                        # and walking the command history.
                        if overlay is "critters"
                            if isNone of lab.hunt.foe
                                if stroke.key is "ArrowLeft"
                                    set lab to (critterWalk with game is lab, dir is "left")
                                if stroke.key is "ArrowRight"
                                    set lab to (critterWalk with game is lab, dir is "right")
                                if stroke.key is "ArrowUp"
                                    set lab to (critterWalk with game is lab, dir is "up")
                                if stroke.key is "ArrowDown"
                                    set lab to (critterWalk with game is lab, dir is "down")
                            if isSome of lab.hunt.foe
                                # Two columns of two, so left and right step
                                # by one and up and down step by two.
                                if stroke.key is "ArrowLeft"
                                    set lab to (critterMenuMoved with game is lab, step is 3)
                                if stroke.key is "ArrowRight"
                                    set lab to (critterMenuMoved with game is lab, step is 1)
                                if stroke.key is "ArrowUp"
                                    set lab to (critterMenuMoved with game is lab, step is 2)
                                if stroke.key is "ArrowDown"
                                    set lab to (critterMenuMoved with game is lab, step is 2)
                                if (stroke.key is " ") or (stroke.key is "Enter")
                                    set lab to (critterConfirm of lab)

                        if overlay is "snake"
                            if stroke.key is "ArrowLeft"
                                set serpent to (snakeSteer with game is serpent, dx is 0 - 1, dy is 0)
                            if stroke.key is "ArrowRight"
                                set serpent to (snakeSteer with game is serpent, dx is 1, dy is 0)
                            if stroke.key is "ArrowUp"
                                set serpent to (snakeSteer with game is serpent, dx is 0, dy is 0 - 1)
                            if stroke.key is "ArrowDown"
                                set serpent to (snakeSteer with game is serpent, dx is 0, dy is 1)
                            if stroke.key is " "
                                set serpent to (newSnake of (clock))

                        if overlay is "blocks"
                            if stroke.key is "ArrowLeft"
                                set stack to (blocksLeft of stack)
                            if stroke.key is "ArrowRight"
                                set stack to (blocksRight of stack)
                            if stroke.key is "ArrowDown"
                                set stack to (blocksDown of stack)
                            if stroke.key is "ArrowUp"
                                set stack to (blocksRotate of stack)
                            if stroke.key is " "
                                set stack to (blocksDrop of stack)
                            if stroke.key is "r"
                                set stack to (blocksRefactor of stack)

                        # A bump is a move, so attacking, buying, looting
                        # and descending are all this and nothing else.
                        # Space restarts a finished run; `Enter` does too
                        # in the original, and cannot here, because
                        # `Enter` already belongs to the prompt.
                        if overlay is "crawl"
                            if stroke.key is "ArrowLeft"
                                set crawling to (
                                    crawlStep with game is crawling,
                                    dx is 0 - 1,
                                    dy is 0)
                            if stroke.key is "ArrowRight"
                                set crawling to (crawlStep with game is crawling, dx is 1, dy is 0)
                            if stroke.key is "ArrowUp"
                                set crawling to (
                                    crawlStep with game is crawling,
                                    dx is 0,
                                    dy is 0 - 1)
                            if stroke.key is "ArrowDown"
                                set crawling to (crawlStep with game is crawling, dx is 0, dy is 1)
                            if (stroke.key is " ") and crawling.over
                                set crawling to (crawlStart of (clock))
                            if crawling.depth > deepest
                                set deepest to crawling.depth

                        if overlay is "dino"
                            if stroke.key is " "
                                if runner.dead
                                    set runner to (dinoFresh of (clock))
                                if not runner.dead
                                    set runner to (dinoJump of runner)
                            if dinoTop > dinoBest
                                set dinoBest to dinoTop

                        if overlay is "2048"
                            if stroke.key is "ArrowLeft"
                                set tiles to (afterMove with board is tiles, direction is Left)
                            if stroke.key is "ArrowRight"
                                set tiles to (afterMove with board is tiles, direction is Right)
                            if stroke.key is "ArrowUp"
                                set tiles to (afterMove with board is tiles, direction is Up)
                            if stroke.key is "ArrowDown"
                                set tiles to (afterMove with board is tiles, direction is Down)
                            if stroke.key is "r"
                                set tiles to (freshBoard of (clock))
                            if tiles.score > bestScore
                                set bestScore to tiles.score

                        if overlay is "minesweeper"
                            if stroke.key is "ArrowLeft"
                                set field to (movedBy with field is field, dx is 0 - 1, dy is 0)
                            if stroke.key is "ArrowRight"
                                set field to (movedBy with field is field, dx is 1, dy is 0)
                            if stroke.key is "ArrowUp"
                                set field to (movedBy with field is field, dx is 0, dy is 0 - 1)
                            if stroke.key is "ArrowDown"
                                set field to (movedBy with field is field, dx is 0, dy is 1)
                            if (stroke.key is " ") or (stroke.key is "Enter")
                                set field to (
                                    revealAt with field is field,
                                    index is field.cursor)
                            if stroke.key is "f"
                                set field to (flagAt with field is field, index is field.cursor)
                            if stroke.key is "r"
                                set field to (freshField of (clock))

                        if overlay is "life"
                            if stroke.key is " "
                                set running to not running
                            if stroke.key is "n"
                                set board to (stepLife of board)
                            if stroke.key is "g"
                                set board to (
                                    stamped with pattern is gunCells,
                                    seed is board.seed)
                            if stroke.key is "p"
                                set board to (
                                    stamped with pattern is pulsarCells,
                                    seed is board.seed)
                            if stroke.key is "c"
                                set board to (
                                    stamped with pattern is gliderCells,
                                    seed is board.seed)

                        if stroke.key is "Escape"
                            if dinoTop > dinoBest
                                set dinoBest to dinoTop
                            if isBlank of overlay
                                set open to no
                            set overlay to ""

component Shell with onBlog, children
    Column class is "page", minHeight is 700
        Terminal
        Status onBlog
        Row justify is "center"
            # 1020, not 700. The listing has four columns and the description
            # was being squeezed into a third of the width it wants; the blog
            # stays a narrow measure because `.prose` caps itself at 665.
            Column maxWidth is 1020, grow is 1, padding is 40, narrowPadding is 18, gap is 0
                children

view title is "Mark Sturman"
    # The key that opens the interactive mode. On the document, so it works
    # wherever the reader is — and the compiled listener stands down while a
    # field has focus, so typing `~` into the terminal's own input does not
    # close it.
    on key "~"
        set open to not open

    # `Shell` sits inside each arm rather than around the `when`.
    # `address` is folded to one value per emitted document, so `page` may
    # only be dispatched on — reading it as an expression to work out which
    # tab is current is exactly what the compiler refuses, and the repair is
    # to let each arm say so with a literal.
    when page
        None
            Shell no
                Column gap is 10
                    Heading "Not found"
                    Link Writing, decoration is "none"
                        Text "back to writing", color is "accent"

        Some with here
            when here
                Home
                    Shell no
                        Column gap is 0
                            Row height is 48
                            Row gap is 8, align is "center", class is "prompt print-in"
                                Text "~/portfolio", class is "prompt-path"
                                Text "$", class is "prompt-mark"
                                Text "whoami"
                                Row class is "caret cursor-blink", width is 8, height is 16

                            Heading "Mark.", class is "hero answer-in"

                            # Two-tone, as the original is: the claim is
                            # italic and grey and the verb is upright and
                            # amber, which is the whole joke of the line.
                            #
                            # `display is "block"`, not the default `Row`. A
                            # `Row` is a flex container and its children are
                            # flex items, and the trailing space in "makes
                            # models " is *collapsed away* between two items —
                            # the words ran together as "modelsrun". In block
                            # flow the spans are inline and the space is a
                            # space.
                            Row display is "block", class is "hero-sub print-in"
                                Text "makes models "
                                Text "run faster", class is "hero-verb"
                                Text "."

                            Row height is 12
                            Text "Transformers written from scratch, DNN kernels hand scheduled in TVM across CPU, GPU and FPGA, and the Rust servers and iOS apps underneath. One person, the whole stack.",
                                color is "muted",
                                lineHeight is 1.7,
                                maxWidth is 620,
                                size is "large"

                            Row height is 24

                            # Two rankings, stated plainly and without a
                            # verification link: the repositories are private
                            # and a dead link reads worse than an unlinked
                            # claim.
                            Column gap is 8,
                                class is "creds print-in",
                                padding is 12,
                                maxWidth is 620
                                Row gap is 10, align is "baseline"
                                    Text "1st in class", class is "cred-rank"
                                    Text "Cornell ECE 5545, benchmarked TVM kernel optimization",
                                        class is "cred-detail"
                                Row gap is 10, align is "baseline"
                                    Text "1st in class", class is "cred-rank"
                                    Text "Cornell CS 5740, NLP held out test accuracy",
                                        class is "cred-detail"

                            Row height is 30
                            Row gap is 8,
                                align is "center",
                                class is "psst print-in",
                                padding is 12,
                                radius is 8
                                Text "psst, this site has an interactive mode. Try pressing"
                                Text "~", class is "kbd", padding is 4

                            Row height is 46

                            # The measurement of the claim the hero just made.
                            Column gap is 10,
                                class is "coverage",
                                padding is 18,
                                maxWidth is 620
                                Row gap is 10, align is "baseline", class is "cov-head"
                                    Text "stack coverage"
                                    Row grow is 1
                                    Text spanned, class is "cov-spanned"
                                    Text ("of " + (text of (listLength of layerNames)) + " layers")
                                Column gap is 3
                                    each row in coverage
                                        CoverageBar row
                                Text "Counted from each project's declared stack, metal at the top.",
                                    class is "cov-note"

                            Row height is 56

                            SectionHead "now", "", "now"
                            Row height is 10
                            Prompt "cat now.txt"
                            Row height is 10
                            Column gap is 2
                                each line in now
                                    LineItem line
                            Row height is 56

                            SectionHead "about", "", "about"
                            Row height is 18

                            # The lead: Instrument Serif at 36px with one
                            # phrase in italic amber, which is the shape of
                            # the section rather than decoration on it.
                            # Block flow for the same reason the hero's
                            # subtitle needs it: the spaces live inside the
                            # text, and a flex container eats them.
                            Row display is "block", class is "about-lead", maxWidth is 665
                                Text aboutOpen
                                Text aboutStress, class is "about-stress"
                                Text aboutClose

                            Row height is 20
                            Column gap is 20, maxWidth is 665
                                each paragraph in about
                                    Text paragraph, color is "muted", lineHeight is 1.75
                            Row height is 56

                            SectionHead "projects", "16 entries", "projects"
                            Row height is 20

                            # The catalogue before the catalogue: a list
                            # answers "what is there", a cross-section answers
                            # "how much, and for how long".
                            Row gap is 40,
                                align is "center",
                                narrowDisplay is "block",
                                class is "rings-row"
                                Figure class is "rings"
                                    # The real drawing at last. Every ring is
                                    # a closed path with the three-harmonic
                                    # wobble `rings.ts` writes, so the disc
                                    # reads as timber rather than as a
                                    # dartboard — which is exactly what the
                                    # box-and-border-radius version could not
                                    # do. The `viewBox` does the scaling that
                                    # `ringScale` was doing by hand.
                                    Svg viewBox is viewBoxText,
                                        label is "Growth rings: one ring a year since 2018, the centre is the first year."
                                        # Outermost first, so the inner ones
                                        # paint over their edges.
                                        Group fill is "none"
                                            each outline in trunkOutlines
                                                Path outline is outline.band,
                                                    stroke is outline.colour,
                                                    strokeWidth is outline.width,
                                                    class is "ring-grow"
                                        # Latewood — the dark line laid down
                                        # as a season closes. Without it nine
                                        # browns read as one gradient and the
                                        # rings cannot be counted.
                                        Group fill is "none",
                                            stroke is "#14110d",
                                            strokeWidth is 1.6,
                                            opacity is 0.85
                                            each outline in trunkOutlines
                                                if outline.last is no
                                                    Path outline is outline.latewood,
                                                        class is "ring-grow"
                                        # Grain. Short and faint on purpose —
                                        # drawn full-radius these read as a
                                        # wireframe rather than as figure in
                                        # the wood.
                                        Group stroke is "#211c14",
                                            strokeWidth is 1.1,
                                            opacity is 0.5
                                            each fleck in grain
                                                Segment fromX is fleck.x1,
                                                    fromY is fleck.y1,
                                                    toX is fleck.x2,
                                                    toY is fleck.y2
                                        Path outline is pithPath, fill is "#4a412a"
                                        Circle x is (decimalOf of trunkExtent),
                                            y is (decimalOf of trunkExtent),
                                            radius is 5.0,
                                            fill is "#2b261e"
                                    Caption class is "rings-caption"
                                        Text ((((((text of FIRST_YEAR) + "–") + (text of lastYear)) + " · ") + (text of workingYears)) + " years shipping · ") + (text of totalCommits) + " commits"
                                Column grow is 1, basis is 0, gap is 12, maxWidth is 420
                                    Text "growth rings", class is "rings-label"
                                    Text "One ring a year since 2018, when I started. The thick ones are the years that shipped something.",
                                        color is "muted",
                                        lineHeight is 1.7

                            Row height is 40
                            Row class is "row-head"
                                Text "depth"
                                Text "status"
                                Text "project"
                                Text "effort", class is "head-right"
                            Column gap is 0
                                each project in cards
                                    WorkRow project
                            Row height is 56

                            SectionHead "range", "13 domains", "range"
                            Row height is 24

                            # The focus tier, behind an accent rail.
                            Column class is "range-focus"
                                each line in focus
                                    RangeRow line, "range-lead"

                            Row height is 30

                            Column class is "range-rest"
                                each line in domains
                                    RangeRow line, "range-plain"
                            Row height is 40

                            Prompt "ls elsewhere:"
                            Row gap is 10, padding is 10
                                Link Writing, decoration is "none"
                                    Text "blog", class is "rss"

                Work with slug
                    Shell no
                        Working (
                            projectWith with all is projects,
                            slug is slug,
                            index is 0,
                            fallback is missingProject)

                Writing
                    Shell yes
                        Column gap is 0
                            Row height is 40
                            Heading "Blog.", class is "title"
                            Row height is 16
                            Row gap is 8, align is "center", class is "tagline"
                                Text "//", class is "slash"
                                Text "build logs, engineering stories, occasional opinions"
                                Link "/rss.xml", class is "rss"
                                    Text "rss"
                            Row height is 28

                            # A `Section`, so each card's `Heading` is an
                            # h2 rather than a second h1. A heading's level
                            # is its nesting depth, and fourteen h1s on one
                            # page is the outline failure the vocabulary is
                            # closed to prevent.
                            Section
                                Column gap is 14
                                    each post in ordered
                                        Card post

                Entry with slug
                    Shell yes
                        # The lookup happens once, at the call, rather than
                        # three times in three bindings.
                        Reading (
                            postWith with all is posts,
                            slug is slug,
                            index is 0,
                            fallback is missingPost)
