# life.zd — `src/lib/game/life.ts` and `src/components/game/life-game.tsx`.
#
# Conway, B3/S23, on a torus. Forty-eight by twenty-eight, eleven
# generations a second, with a Gosper gun on the board at the start.
#
# WHY THE GRID WRAPS. A bounded grid quietly changes the rule at the
# edges: a glider that should travel forever hits a wall and dissolves
# into a block, which reads as a bug in the simulation rather than as a
# boundary condition. On a torus every cell has exactly eight neighbours
# and the rule is uniform everywhere.
#
# WHY A ROW IS A `Text`. The obvious shape is one flat list of 1,344
# truths, and it is the wrong one here: `append` builds a new list, so a
# fold that grows a 1,344-element list copies about nine hundred thousand
# elements per generation. A row of forty-eight characters copies about a
# thousand, and twenty-eight rows is another four hundred — thirty
# thousand against nine hundred thousand, for the same board. The
# representation is a consequence of the language's cost model rather
# than a preference.
#
# WHY IT DRAWS INTO A `Scene`. The original's comment is the reason: the
# DOM version was 1,344 buttons re-rendering eleven times a second, which
# is exactly what a device budget exists to keep off a weak laptop. A
# `Scene` is one canvas and one draw list, and the whole board is a
# *single* `Path` — every live cell is a subpath of one `d`, so a
# generation is one shape rather than a thousand.

record Life
    rows       is List of Text
    generation is Whole
    seed       is Whole

state lifeWidth is static Whole starting 48
state lifeHeight is static Whole starting 28
state lifeCell is static Whole starting 12

# The patterns worth having on hand, as offsets from a top-left origin.
# These are the three that make the rule legible: a glider shows
# translation, a pulsar oscillation, and the Gosper gun unbounded growth
# from a finite start — which is the property that makes Life interesting
# rather than merely pretty.
state gliderCells is static Text from build read "content/terminal/life-glider.txt"
state pulsarCells is static Text from build read "content/terminal/life-pulsar.txt"
state gunCells is static Text from build read "content/terminal/life-gun.txt"

function emptyRows of remaining
    if remaining is 0
        give empty
    give append (repeat with value is ".", count is lifeWidth) to (emptyRows of (remaining - 1))

function blankLife
    give Life with rows is (emptyRows of lifeHeight), generation is 0, seed is 1

# --- reading the board ------------------------------------------------------
#
# `wrap` is `(n + max) % max` and is written out because `mod` gives an
# `Option`: the divisor is a board dimension and never zero, so the
# fallback is unreachable and saying so beats hiding it.

function wrapped with value, most
    give valueOr with maybe is (mod with value is value + most, divisor is most), fallback is 0

function aliveAt with rows, x, y
    with row is (
        valueOr with maybe is (
            listAt with value is rows,
            index is (wrapped with value is y, most is lifeHeight)),
        fallback is "")
    give (
        valueOr with maybe is (
            textAt with value is row,
            index is (wrapped with value is x, most is lifeWidth)),
        fallback is ".") is "#"

# Eight calls, so this stays a function. The conditional expression
# replaces the helpers that existed *only* because there was no
# conditional expression; one that is called eight times has earned its
# name.
function oneIfAlive with rows, x, y
    give 1 if aliveAt with rows is rows, x is x, y is y otherwise 0

function neighbours with rows, x, y
    give (((
        oneIfAlive with rows is rows,
        x is x - 1,
        y is y - 1) + (oneIfAlive with rows is rows,
        x is x,
        y is y - 1)) + ((oneIfAlive with rows is rows,
        x is x + 1,
        y is y - 1) + (oneIfAlive with rows is rows,
        x is x - 1,
        y is y))) + (((oneIfAlive with rows is rows,
        x is x + 1,
        y is y) + (oneIfAlive with rows is rows,
        x is x - 1,
        y is y + 1)) + ((oneIfAlive with rows is rows,
        x is x,
        y is y + 1) + (oneIfAlive with rows is rows,
        x is x + 1,
        y is y + 1)))

# B3/S23: a dead cell with exactly three live neighbours is born, a live
# cell with two or three survives, everything else dies.
#
# COMPUTED INTO FRESH ROWS, NEVER IN PLACE. Updating the board as you walk
# it means later cells see their neighbours' *new* states, which is a
# different automaton entirely and one whose output looks superficially
# plausible. It is the classic way this gets written wrong, and in this
# language it is not expressible — `rows` is the old board for the whole
# of the sweep because there is no way for it to be anything else.

function stepLife of game
    give Life with rows is (steppedRows with rows is game.rows, y is 0, taken is empty),
        generation is game.generation + 1,
        seed is game.seed

function steppedRows with rows, y, taken
    if y is lifeHeight
        give taken
    give steppedRows with rows is rows,
        y is y + 1,
        taken is (append (steppedRow with rows is rows, y is y, x is 0, taken is "") to taken)

function steppedRow with rows, y, x, taken
    if x is lifeWidth
        give taken
    give steppedRow with rows is rows,
        y is y,
        x is x + 1,
        taken is taken + (nextCell with rows is rows, x is x, y is y)

function nextCell with rows, x, y
    with around is (neighbours with rows is rows, x is x, y is y)
    if aliveAt with rows is rows, x is x, y is y
        if (around is 2) or (around is 3)
            give "#"
        give "."
    if around is 3
        give "#"
    give "."

function population of game
    from game.rows
    fold each row into total starting 0 to total + (
        liveIn with row is row,
        index is 0,
        running is 0)

function liveIn with row, index, running
    if index is (textLength of row)
        give running
    if (
        valueOr with maybe is (textAt with value is row, index is index),
        fallback is ".") is "#"
        give liveIn with row is row, index is index + 1, running is running + 1
    give liveIn with row is row, index is index + 1, running is running

# --- stamping a pattern -----------------------------------------------------
#
# Centred, so a stamp lands somewhere visible rather than in a corner.

function stamped with pattern, seed
    with points is (split with value is pattern, using is " ")
    with size is (patternSize with points is points, index is 0, wide is 0, tall is 0)
    give Life with rows is (
        placedAll with rows is (emptyRows of lifeHeight),
        points is points,
        index is 0,
        offsetX is (quotientOr with value is lifeWidth - size.wide, divisor is 2),
        offsetY is (quotientOr with value is lifeHeight - size.tall, divisor is 2)),
        generation is 0,
        seed is seed

record Extent
    wide is Whole
    tall is Whole

function quotientOr with value, divisor
    give valueOr with maybe is (quotient with value is value, divisor is divisor), fallback is 0

function patternSize with points, index, wide, tall
    when listAt with value is points, index is index
        None
            give Extent with wide is wide + 1, tall is tall + 1
        Some with point
            give patternSize with points is points,
                index is index + 1,
                wide is (
                    max with first is wide,
                    second is (coordinate with point is point, second is no)),
                tall is (
                    max with first is tall,
                    second is (coordinate with point is point, second is yes))

function coordinate with point, second
    if second
        give valueOr with maybe is (parseWhole of (after with value is point, delimiter is ",")),
            fallback is 0
    give valueOr with maybe is (parseWhole of (before with value is point, delimiter is ",")),
        fallback is 0

function placedAll with rows, points, index, offsetX, offsetY
    when listAt with value is points, index is index
        None
            give rows
        Some with point
            give placedAll with rows is (
                liveAt with rows is rows,
                x is (coordinate with point is point, second is no) + offsetX,
                y is (coordinate with point is point, second is yes) + offsetY),
                points is points,
                index is index + 1,
                offsetX is offsetX,
                offsetY is offsetY

function liveAt with rows, x, y
    give rewritten with rows is rows, y is y, index is 0, taken is empty, x is x

function rewritten with rows, y, index, taken, x
    when listAt with value is rows, index is index
        None
            give taken
        Some with row
            if index is y
                give rewritten with rows is rows,
                    y is y,
                    index is index + 1,
                    taken is (append (withLiveCell with row is row, x is x) to taken),
                    x is x
            give rewritten with rows is rows,
                y is y,
                index is index + 1,
                taken is (append row to taken),
                x is x

function withLiveCell with row, x
    give ((slice with value is row, start is 0, stop is x) + "#") + (
        slice with value is row,
        start is x + 1,
        stop is (textLength of row))

# --- the drawing ------------------------------------------------------------
#
# One `Path` for the whole board. Every live cell is a subpath of one `d`,
# so a generation is a single shape however many cells are alive — which
# is the difference between one draw call and a thousand, and is the whole
# reason the vector vocabulary was worth having.

function boardPath of game
    give cellPaths with rows is game.rows, y is 0, taken is ""

function cellPaths with rows, y, taken
    if y is lifeHeight
        give taken
    give cellPaths with rows is rows,
        y is y + 1,
        taken is taken + (
            rowPath with row is (
                valueOr with maybe is (listAt with value is rows, index is y),
                fallback is ""),
            y is y,
            x is 0,
            taken is "")

function rowPath with row, y, x, taken
    if x is lifeWidth
        give taken
    if (valueOr with maybe is (textAt with value is row, index is x), fallback is ".") is "#"
        give rowPath with row is row,
            y is y,
            x is x + 1,
            taken is taken + (squareAt with x is x, y is y)
    give rowPath with row is row, y is y, x is x + 1, taken is taken

# A cell inset by one pixel, so the grid reads as cells rather than as a
# solid block where a region is full.
function squareAt with x, y
    with left is (x * lifeCell)
    with top is (y * lifeCell)
    give ((((("M" + (text of left)) + " ") + (text of top)) + "h") + (text of (lifeCell - 1))) + "v" + (text of (lifeCell - 1)) + "h-" + (text of (lifeCell - 1)) + "Z"

state lifeViewBox is static Text from (("0 0 " + (text of (lifeWidth * lifeCell))) + " ") + (text of (lifeHeight * lifeCell))
