# frontmatter.zd — reading a post's header at build time.
#
# WHY THIS FILE EXISTS AT ALL. `examples/blog.zd` in the compiler's own
# repository writes its post titles out by hand, and says why:
#
#   > Front matter is a second grammar inside the file, and parsing one
#   > needs text operations the language does not have — there is no
#   > `split`, no `first line`, and `at` over `Text` is not defined. So the
#   > three are written out here… That is a missing library, not a missing
#   > capability.
#
# The library is no longer missing. `split`, `lines`, `before`, `after`,
# `trim`, `startsWith`, `withoutPrefix` and `withoutSuffix` are all in
# `text.zd` now, so the header parses in the language and a post's title
# comes off the post. That comment is the one thing about this that was
# out of date rather than untrue — it was true when it was written.
#
# WHAT A HEADER IS, HERE. Three fences and the fields between them:
#
#     ---
#     title: The ruler is made of people
#     summary: "…"
#     date: "2026-08-02"
#     ---
#     the body
#
# This is not a YAML parser and does not pretend to be one. It reads
# `key: value` off a line, trims it, and takes surrounding quotes off. No
# nesting, no lists, no block scalars, no anchors — every one of which is
# a thing the portfolio's front matter does not contain, and the day it
# does, this refuses to guess rather than reading half of it.

# Everything after the opening fence.
function afterOpeningFence of raw
    give after with value is raw, delimiter is "---"

# The header: between the opening fence and the closing one.
function headerOf of raw
    give before with value is (afterOpeningFence of raw), delimiter is "---"

# The body: everything after the closing fence. A file with no header at
# all yields the whole file, because `after` of a delimiter that is not
# there gives the text unchanged — which is the right answer for a plain
# markdown file with no front matter.
function bodyOf of raw
    give after with value is (afterOpeningFence of raw), delimiter is "---"

# --- reading one field -----------------------------------------------------

# The first line whose key matches. `""` when there is none, which is what
# makes a missing field an empty title rather than a build that stops.
function lineFor with items, key, index
    when listAt with value is items, index is index
        None
            give ""
        Some with line
            if startsWith with value is (trim of line), prefix is (key + ":")
                give line
            give lineFor with items is items, key is key, index is index + 1

# `after` the *first* colon, so a value containing one — and the summaries
# here do — keeps everything past it.
function unquoted of value
    give withoutSuffix with value is (withoutPrefix with value is value, prefix is "\""), suffix is "\""

function fieldOf with raw, key
    give unquoted of (trim of (after with value is (lineFor with items is (lines of (headerOf of raw)), key is key, index is 0), delimiter is ":"))

# --- the slug --------------------------------------------------------------
#
# `content/blog/the-ruler-is-made-of-people.mdx` → `the-ruler-is-made-of-people`.
# `afterLast` and `beforeLast` rather than a split, because a path has one
# last separator and one last dot and both are the ones that matter.

function slugOf of path
    give beforeLast with value is (afterLast with value is path, delimiter is "/"), delimiter is "."

# --- making a bare URL clickable -------------------------------------------
#
# THE PROBLEM, STATED EXACTLY. The posts write their references as inline
# code — `` `https://arxiv.org/abs/2603.20397` `` — and CommonMark
# deliberately never linkifies the inside of a code span. GitHub-flavoured
# autolinking does not either, for the same reason: a code span is a
# quotation, and rewriting what is inside one would change what the author
# wrote. Both the real site and the first version of this one therefore
# render those as unclickable text, which is correct and unhelpful.
#
# So the rewrite happens *before* the markdown is parsed, where it is a
# decision this program is making rather than a rule the renderer is
# breaking: a code span whose whole content is a URL becomes a link, and
# every other code span is left exactly as it was.
#
# WHY IT SPLITS TWICE. A fenced block is three backticks and a code span is
# one, so splitting on a single backtick would cut fences in half and put
# them back wrong. The body is cut on the fence first, and only the pieces
# *between* fences are cut on the backtick — the same alternation the
# reading time uses, for the same reason.

function isOddNumber of value
    give (valueOr with maybe is (mod with value is value, divisor is 2), fallback is 0) is 1

# A code span whose content is a URL becomes a markdown link; anything else
# gets its backticks back and is unchanged.
function codeOrLink of piece
    if startsWith with value is piece, prefix is "http"
        give "[" + piece + "](" + piece + ")"
    give "`" + piece + "`"

function spanAt with parts, index
    with piece is (valueOr with maybe is (listAt with value is parts, index is index), fallback is "")
    if isOddNumber of index
        give codeOrLink of piece
    give piece

function spanParts of parts
    from (indices of (listLength of parts))
    map each index to (spanAt with parts is parts, index is index)

# One piece of prose, with its code spans considered.
function inlineLinked of piece
    give join with parts is (spanParts of (split with value is piece, using is "`")), using is ""

function partAt with parts, index
    with piece is (valueOr with maybe is (listAt with value is parts, index is index), fallback is "")
    # An odd piece is the inside of a fenced block. Nothing in there is
    # touched: a URL in a code sample is a sample, not a destination.
    if isOddNumber of index
        give piece
    give inlineLinked of piece

function linkedParts of parts
    from (indices of (listLength of parts))
    map each index to (partAt with parts is parts, index is index)

function linkified of body
    give join with parts is (linkedParts of (split with value is body, using is "```")), using is "```"
